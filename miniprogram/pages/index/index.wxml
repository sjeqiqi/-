<!-- pages/index/index.wxml -->
<view class="container">
  <!-- 顶部步骤条 -->
  <view class="steps-bar">
    <view class="step-item active">
      <view class="step-icon">1</view>
      <text class="step-text">羊只信息</text>
    </view>
    <view class="step-item">
      <view class="step-icon">2</view>
      <text class="step-text">原料价格</text>
    </view>
    <view class="step-item">
      <view class="step-icon">3</view>
      <text class="step-text">配方结果</text>
    </view>
  </view>

  <!-- 表单主体卡片 -->
  <view class="card">
    <view class="card-title">
      <text>🐐 第一步：填写羊只信息</text>
      <text class="badge-green">国家标准</text>
    </view>
    <view class="card-subtitle">按单只羊的实际生理阶段填写，系统自动核算每日基础与生产营养需要。</view>

    <!-- 生理阶段选择器分段按钮 -->
    <view class="form-group">
      <text class="form-label">羊只生理阶段</text>
      <view class="class-segmented-bar">
        <view 
          class="class-seg-item {{classList[classIndex].value === 'lactating' ? 'active' : ''}}" 
          bindtap="selectClass" 
          data-index="0"
        >
          🥛 成年泌乳奶山羊
        </view>
        <view 
          class="class-seg-item {{classList[classIndex].value === 'maintenance' ? 'active' : ''}}" 
          bindtap="selectClass" 
          data-index="1"
        >
          🌾 成年维持期羊
        </view>
      </view>
    </view>

    <!-- 体重 -->
    <view class="form-group">
      <view style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx;">
        <text class="form-label" style="margin-bottom: 0;">羊只体重 (kg)</text>
        <text class="form-hint" style="margin-top: 0;">范围 25 – 90 kg</text>
      </view>
      <input 
        class="form-input" 
        type="digit" 
        placeholder="例如 50" 
        value="{{bodyWeightKg}}" 
        bindinput="onWeightInput"
      />
      <!-- 快捷选择芯片 -->
      <view class="quick-chips">
        <text class="quick-chip-label">快捷填入：</text>
        <view 
          wx:for="{{['45', '50', '55', '60', '70']}}" 
          wx:key="*this" 
          class="chip-item {{bodyWeightKg === item ? 'chip-active' : ''}}"
          bindtap="quickSetWeight"
          data-val="{{item}}"
        >
          {{item}}kg
        </view>
      </view>
    </view>

    <!-- 泌乳期专属字段 -->
    <block wx:if="{{classList[classIndex].value === 'lactating'}}">
      <view class="form-group">
        <view style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx;">
          <text class="form-label" style="margin-bottom: 0;">日产奶量 (kg/天)</text>
          <text class="form-hint" style="margin-top: 0;">范围 0.2 – 5.0 kg/天</text>
        </view>
        <input 
          class="form-input" 
          type="digit" 
          placeholder="例如 2.5" 
          value="{{milkKg}}" 
          bindinput="onMilkInput"
        />
        <!-- 快捷选择产奶量 -->
        <view class="quick-chips">
          <text class="quick-chip-label">快捷填入：</text>
          <view 
            wx:for="{{['1.5', '2.0', '2.5', '3.0', '3.5']}}" 
            wx:key="*this" 
            class="chip-item {{milkKg === item ? 'chip-active' : ''}}"
            bindtap="quickSetMilk"
            data-val="{{item}}"
          >
            {{item}}kg
          </view>
        </view>
      </view>

      <view class="form-group">
        <view style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx;">
          <text class="form-label" style="margin-bottom: 0;">乳脂率 (%, 可选)</text>
          <text class="form-hint" style="margin-top: 0;">不填默认 4.0%</text>
        </view>
        <input 
          class="form-input" 
          type="digit" 
          placeholder="留空默认 4.0%" 
          value="{{milkFatPercent}}" 
          bindinput="onFatInput"
        />
      </view>
    </block>

    <!-- 错误提示 -->
    <view wx:if="{{errorMessage}}" class="alert-box alert-danger" style="margin-top: 20rpx;">
      {{errorMessage}}
    </view>

    <!-- 按钮 -->
    <view class="btn-row">
      <button class="btn-primary" bindtap="handleNext">下一步：选择原料与价格 ➔</button>
    </view>
  </view>
</view>
