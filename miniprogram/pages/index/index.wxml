<!-- pages/index/index.wxml -->
<view class="container">
  <!-- 顶部步骤条 -->
  <view class="steps-bar">
    <view class="step-item active">
      <view class="step-icon">1</view>
      <text class="step-text">牧场信息</text>
    </view>
    <view class="step-item">
      <view class="step-icon">2</view>
      <text class="step-text">原料价格</text>
    </view>
    <view class="step-item">
      <view class="step-icon">3</view>
      <text class="step-text">配方结果</text>
    </view>
  </view>

  <!-- 表单主体卡片 -->
  <view class="card">
    <view class="card-title">
      <text>🏡 第一步：填写牧场信息</text>
      <text class="badge-green">规模化牧场管理</text>
    </view>
    <view class="card-subtitle">
      覆盖全国奶山羊优势产区与群体结构，支持精准科学核算与全场原料用量联动。
    </view>

    <!-- 1. 全国奶山羊优势主产区选择 -->
    <view class="form-group">
      <view class="section-sub-header">
        <text class="form-label" style="margin-bottom: 0;">📍 优势主产区选择</text>
        <text class="form-hint" style="margin-top: 0;">自动联动产区采购行情与营养库</text>
      </view>

      <view class="region-cards-grid">
        <view 
          wx:for="{{regions}}" 
          wx:key="id" 
          class="region-card-item {{selectedRegionIndex === index ? 'active' : ''}}"
          bindtap="selectRegionCard"
          data-index="{{index}}"
        >
          <view class="region-card-top">
            <text class="region-card-name">{{item.name}}</text>
            <text class="region-card-badge {{selectedRegionIndex === index ? 'active' : ''}}">{{item.badge}}</text>
          </view>
          <text class="region-card-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>

    <!-- 2. 羊群总存栏量 -->
    <view class="form-group" style="margin-top: 28rpx;">
      <view class="section-sub-header">
        <text class="form-label" style="margin-bottom: 0;">🐑 羊群总存栏量 (只)</text>
        <text class="form-hint" style="margin-top: 0;">用于全场日耗料量与采购核算</text>
      </view>
      <input 
        class="form-input" 
        type="number" 
        placeholder="例如 500" 
        value="{{totalFlockCount}}" 
        bindinput="onTotalFlockInput"
      />
      <!-- 快捷选择总存栏芯片 -->
      <view class="quick-chips">
        <text class="quick-chip-label">快捷设定：</text>
        <view 
          wx:for="{{presetFlocks}}" 
          wx:key="*this" 
          class="chip-item {{totalFlockCount === item ? 'chip-active' : ''}}"
          bindtap="quickSetTotalFlock"
          data-val="{{item}}"
        >
          {{item}}只
        </view>
      </view>
    </view>

    <!-- 3. 群体结构分布与占比 (隐藏维持期，聚焦核心生产群) -->
    <view class="form-group" style="margin-top: 28rpx;">
      <view class="section-sub-header">
        <text class="form-label" style="margin-bottom: 0;">📊 群体结构分布与占比</text>
        <text class="form-hint" style="margin-top: 0;">重点聚焦泌乳期核心生产群</text>
      </view>

      <!-- 结构卡片展示 -->
      <view class="herd-structure-box">
        <!-- 核心泌乳期生产群 -->
        <view class="herd-row highlight-lactating">
          <view class="herd-row-left">
            <view class="herd-icon-tag">🥛</view>
            <view>
              <view style="display: flex; align-items: center; gap: 8rpx;">
                <text class="herd-stage-title">成年泌乳期核心生产群</text>
                <text class="badge-green" style="font-size: 18rpx; padding: 2rpx 8rpx;">核心计算群</text>
              </view>
              <text class="herd-stage-desc">日粮配方测算主体，直接决定产奶效益</text>
            </view>
          </view>
          <view class="herd-row-right">
            <text class="herd-count-text">{{lactatingCount}} 只</text>
            <text class="herd-pct-text">占比 {{lactatingPct}}%</text>
          </view>
        </view>

        <!-- 青年育成羊 -->
        <view class="herd-row">
          <view class="herd-row-left">
            <view class="herd-icon-tag">🌿</view>
            <view>
              <text class="herd-stage-title">青年育成羊 (3–12月龄)</text>
              <text class="herd-stage-desc">骨骼与体成熟期后备种群</text>
            </view>
          </view>
          <view class="herd-row-right">
            <text class="herd-count-text">{{growingCount}} 只</text>
            <text class="herd-pct-text">占比 {{growingPct}}%</text>
          </view>
        </view>

        <!-- 幼年期羔羊 -->
        <view class="herd-row">
          <view class="herd-row-left">
            <view class="herd-icon-tag">🍼</view>
            <view>
              <text class="herd-stage-title">幼年期羔羊 (0–3月龄)</text>
              <text class="herd-stage-desc">哺乳及瘤胃发育初期幼羊</text>
            </view>
          </view>
          <view class="herd-row-right">
            <text class="herd-count-text">{{lambCount}} 只</text>
            <text class="herd-pct-text">占比 {{lambPct}}%</text>
          </view>
        </view>
      </view>

      <!-- 泌乳期占比微调滑块 -->
      <view class="slider-control-row">
        <text class="slider-label">核心泌乳群占比微调：</text>
        <slider 
          class="herd-slider" 
          min="50" 
          max="90" 
          step="5" 
          value="{{lactatingPct}}" 
          activeColor="#059669" 
          block-size="18" 
          bindchange="onLactatingSliderChange"
        />
        <text class="slider-val-tag">{{lactatingPct}}%</text>
      </view>
      <text class="form-hint" style="margin-top: 6rpx;">
        💡 提示：系统优先聚焦成年泌乳群精准日粮求解，并按全场规模联动换算采购配料总吨位。
      </text>
    </view>

    <!-- 4. 核心生产群单羊生理指标微调 -->
    <view class="form-group" style="margin-top: 28rpx;">
      <view class="section-sub-header">
        <text class="form-label" style="margin-bottom: 0;">⚙️ 核心泌乳羊生理指标微调</text>
        <text class="form-hint" style="margin-top: 0;">已预置科学默认值，可按需修改</text>
      </view>

      <!-- 体重 -->
      <view style="margin-bottom: 20rpx;">
        <view style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10rpx;">
          <text class="sub-form-label">羊只均重 (kg)</text>
          <text class="form-hint" style="margin-top: 0;">范围 25 – 90 kg</text>
        </view>
        <input 
          class="form-input" 
          type="digit" 
          placeholder="例如 50" 
          value="{{bodyWeightKg}}" 
          bindinput="onWeightInput"
        />
        <view class="quick-chips">
          <text class="quick-chip-label">快捷填入：</text>
          <view 
            wx:for="{{['45', '50', '55', '60', '70']}}" 
            wx:key="*this" 
            class="chip-item {{bodyWeightKg === item ? 'chip-active' : ''}}"
            bindtap="quickSetWeight"
            data-val="{{item}}"
          >
            {{item}}kg
          </view>
        </view>
      </view>

      <!-- 日均产奶量 -->
      <view style="margin-bottom: 20rpx;">
        <view style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10rpx;">
          <text class="sub-form-label">日均产奶量 (kg/天)</text>
          <text class="form-hint" style="margin-top: 0;">范围 0.2 – 5.0 kg/天</text>
        </view>
        <input 
          class="form-input" 
          type="digit" 
          placeholder="例如 2.5" 
          value="{{milkKg}}" 
          bindinput="onMilkInput"
        />
        <view class="quick-chips">
          <text class="quick-chip-label">快捷填入：</text>
          <view 
            wx:for="{{['1.5', '2.0', '2.5', '3.0', '3.5']}}" 
            wx:key="*this" 
            class="chip-item {{milkKg === item ? 'chip-active' : ''}}"
            bindtap="quickSetMilk"
            data-val="{{item}}"
          >
            {{item}}kg
          </view>
        </view>
      </view>

      <!-- 乳脂率 -->
      <view>
        <view style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10rpx;">
          <text class="sub-form-label">目标乳脂率 (%, 可选)</text>
          <text class="form-hint" style="margin-top: 0;">预设 4.0%</text>
        </view>
        <input 
          class="form-input" 
          type="digit" 
          placeholder="留空默认 4.0%" 
          value="{{milkFatPercent}}" 
          bindinput="onFatInput"
        />
      </view>
    </view>

    <!-- 错误提示 -->
    <view wx:if="{{errorMessage}}" class="alert-box alert-danger" style="margin-top: 20rpx;">
      {{errorMessage}}
    </view>

    <!-- 下一步按钮 -->
    <view class="btn-row" style="margin-top: 32rpx;">
      <button class="btn-primary" bindtap="handleNext">下一步：选择原料与价格 ➔</button>
    </view>
  </view>

  <!-- 智能硬件控制入口 -->
  <view class="weigh-entry-card" bindtap="goToWeighPage">
    <view class="weigh-entry-left">
      <text class="weigh-entry-icon">⚖️</text>
      <view>
        <text class="weigh-entry-title">自动称量仪器控制台</text>
        <text class="weigh-entry-desc">树莓派 BLE 智能称重 · 远程配料与闸门控制</text>
      </view>
    </view>
    <text class="weigh-entry-arrow">➔</text>
  </view>
</view>
