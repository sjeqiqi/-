<!-- pages/index/index.wxml -->
<view class="container">
  <!-- 顶部步骤条 -->
  <view class="steps-bar">
    <view class="step-item active">
      <view class="step-icon">1</view>
      <text class="step-text">牧场信息</text>
    </view>
    <view class="step-item">
      <view class="step-icon">2</view>
      <text class="step-text">原料价格</text>
    </view>
    <view class="step-item">
      <view class="step-icon">3</view>
      <text class="step-text">配方结果</text>
    </view>
  </view>

  <!-- 表单主体卡片 -->
  <view class="card">
    <view class="card-title">
      <text>{{calcMode === 'pasture' ? '🏡 第一步：填写牧场信息' : '🐐 第一步：填写单羊信息'}}</text>
      <text class="badge-green">{{calcMode === 'pasture' ? '规模化牧场管理' : '单只个体精准'}}</text>
    </view>
    <view class="card-subtitle">
      {{calcMode === 'pasture' ? '覆盖全国奶山羊优势产区与群体结构，支持精准科学核算与全场原料用量联动。' : '按单只羊的实际生理阶段填写，系统自动核算每日基础维持与生产营养需要。'}}
    </view>

    <!-- 顶部分段模式切换开关 -->
    <view class="calc-mode-segmented-bar">
      <view 
        class="calc-mode-item {{calcMode === 'pasture' ? 'active' : ''}}" 
        bindtap="switchCalcMode" 
        data-mode="pasture"
      >
        🏢 规模化牧场模式 (群体)
      </view>
      <view 
        class="calc-mode-item {{calcMode === 'single' ? 'active' : ''}}" 
        bindtap="switchCalcMode" 
        data-mode="single"
      >
        🐐 单只精准模式 (个体)
      </view>
    </view>

    <!-- 1. 全国奶山羊优势主产区选择 (两种模式均支持联动产区行情) -->
    <view class="form-group" style="margin-top: 24rpx;">
      <view class="section-sub-header">
        <text class="form-label" style="margin-bottom: 0;">📍 优势主产区选择</text>
        <text class="form-hint" style="margin-top: 0;">自动联动产区采购行情与营养库</text>
      </view>

      <view class="region-cards-grid">
        <view 
          wx:for="{{regions}}" 
          wx:key="id" 
          class="region-card-item {{selectedRegionIndex === index ? 'active' : ''}}"
          bindtap="selectRegionCard"
          data-index="{{index}}"
        >
          <view class="region-card-top">
            <text class="region-card-name">{{item.name}}</text>
            <text class="region-card-badge {{selectedRegionIndex === index ? 'active' : ''}}">{{item.badge}}</text>
          </view>
          <text class="region-card-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>

    <!-- ======================================================= -->
    <!-- 模式 A：规模化牧场模式 (群体结构分布与全场联动)            -->
    <!-- ======================================================= -->
    <block wx:if="{{calcMode === 'pasture'}}">
      <!-- 2. 羊群总存栏量 -->
      <view class="form-group" style="margin-top: 28rpx;">
        <view class="section-sub-header">
          <text class="form-label" style="margin-bottom: 0;">🐑 羊群总存栏量 (只)</text>
          <text class="form-hint" style="margin-top: 0;">用于全场日耗料量与采购核算</text>
        </view>
        <input 
          class="form-input" 
          type="number" 
          placeholder="例如 500" 
          value="{{totalFlockCount}}" 
          bindinput="onTotalFlockInput"
        />
      <!-- 快捷选择总存栏芯片 -->
      <view class="quick-chips">
        <text class="quick-chip-label">快捷设定：</text>
        <view 
          wx:for="{{presetFlocks}}" 
          wx:key="*this" 
          class="chip-item {{totalFlockCount === item ? 'chip-active' : ''}}"
          bindtap="quickSetTotalFlock"
          data-val="{{item}}"
        >
          {{item}}只
        </view>
      </view>
    </view>

    <!-- 3. 群体结构分布与占比 (支持直接修改数字与切换核心计算群) -->
    <view class="form-group" style="margin-top: 28rpx;">
      <view class="section-sub-header">
        <text class="form-label" style="margin-bottom: 0;">📊 群体结构分布与核心计算群</text>
        <text class="form-hint" style="margin-top: 0;">可直接修改只数/占比，点击卡片切换计算主体</text>
      </view>

      <!-- 结构卡片展示 -->
      <view class="herd-structure-box">
        <!-- 1. 成年泌乳期生产群 -->
        <view class="herd-row {{coreTarget === 'lactating' ? 'highlight-core' : ''}}" bindtap="selectCoreTarget" data-target="lactating">
          <view class="herd-row-left">
            <view class="herd-icon-tag">🥛</view>
            <view class="herd-info-col">
              <view class="herd-title-badge-row">
                <text class="herd-stage-title">成年泌乳期生产群</text>
                <view wx:if="{{coreTarget === 'lactating'}}" class="core-active-badge">✓ 核心计算群</view>
                <view wx:else class="core-select-btn">设为核心群</view>
              </view>
              <text class="herd-stage-desc">日粮配方测算主体，直接决定产奶效益与体况</text>
            </view>
          </view>
          <view class="herd-row-right" catchtap="stopPropagation">
            <view class="herd-number-field">
              <input 
                class="herd-count-input" 
                type="number" 
                value="{{lactatingCount}}" 
                bindinput="onHerdCountInput" 
                data-stage="lactating" 
              />
              <text class="herd-unit-label">只</text>
            </view>
            <view class="herd-pct-field">
              <text class="herd-pct-prefix">占</text>
              <input 
                class="herd-pct-input" 
                type="number" 
                value="{{lactatingPct}}" 
                bindinput="onHerdPctInput" 
                data-stage="lactating" 
              />
              <text class="herd-unit-label">%</text>
            </view>
          </view>
        </view>

        <!-- 2. 青年育成羊 -->
        <view class="herd-row {{coreTarget === 'growing' ? 'highlight-core' : ''}}" bindtap="selectCoreTarget" data-target="growing">
          <view class="herd-row-left">
            <view class="herd-icon-tag">🌿</view>
            <view class="herd-info-col">
              <view class="herd-title-badge-row">
                <text class="herd-stage-title">青年育成羊 (3–12月龄)</text>
                <view wx:if="{{coreTarget === 'growing'}}" class="core-active-badge">✓ 核心计算群</view>
                <view wx:else class="core-select-btn">设为核心群</view>
              </view>
              <text class="herd-stage-desc">骨骼与体成熟期后备种群，生长与维持营养目标</text>
            </view>
          </view>
          <view class="herd-row-right" catchtap="stopPropagation">
            <view class="herd-number-field">
              <input 
                class="herd-count-input" 
                type="number" 
                value="{{growingCount}}" 
                bindinput="onHerdCountInput" 
                data-stage="growing" 
              />
              <text class="herd-unit-label">只</text>
            </view>
            <view class="herd-pct-field">
              <text class="herd-pct-prefix">占</text>
              <input 
                class="herd-pct-input" 
                type="number" 
                value="{{growingPct}}" 
                bindinput="onHerdPctInput" 
                data-stage="growing" 
              />
              <text class="herd-unit-label">%</text>
            </view>
          </view>
        </view>

        <!-- 3. 幼年期羔羊 -->
        <view class="herd-row {{coreTarget === 'lamb' ? 'highlight-core' : ''}}" bindtap="selectCoreTarget" data-target="lamb">
          <view class="herd-row-left">
            <view class="herd-icon-tag">🍼</view>
            <view class="herd-info-col">
              <view class="herd-title-badge-row">
                <text class="herd-stage-title">幼年期羔羊 (0–3月龄)</text>
                <view wx:if="{{coreTarget === 'lamb'}}" class="core-active-badge">✓ 核心计算群</view>
                <view wx:else class="core-select-btn">设为核心群</view>
              </view>
              <text class="herd-stage-desc">哺乳及瘤胃发育初期幼羊，高蛋白易消化需求</text>
            </view>
          </view>
          <view class="herd-row-right" catchtap="stopPropagation">
            <view class="herd-number-field">
              <input 
                class="herd-count-input" 
                type="number" 
                value="{{lambCount}}" 
                bindinput="onHerdCountInput" 
                data-stage="lamb" 
              />
              <text class="herd-unit-label">只</text>
            </view>
            <view class="herd-pct-field">
              <text class="herd-pct-prefix">占</text>
              <input 
                class="herd-pct-input" 
                type="number" 
                value="{{lambPct}}" 
                bindinput="onHerdPctInput" 
                data-stage="lamb" 
              />
              <text class="herd-unit-label">%</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 泌乳期占比微调滑块 -->
      <view class="slider-control-row">
        <text class="slider-label">核心泌乳群占比快捷滑块：</text>
        <slider 
          class="herd-slider" 
          min="40" 
          max="90" 
          step="5" 
          value="{{lactatingPct}}" 
          activeColor="#059669" 
          block-size="18" 
          bindchange="onLactatingSliderChange"
        />
        <text class="slider-val-tag">{{lactatingPct}}%</text>
      </view>
      <text class="form-hint" style="margin-top: 6rpx;">
        💡 提示：支持直接点击输入框修改只数或占比。系统将以选定的【核心计算群】只数联动折算全场日配料总吨位。
      </text>
    </view>

    <!-- 4. 核心计算群生理指标微调 -->
    <view class="form-group" style="margin-top: 28rpx;">
      <view class="section-sub-header">
        <text class="form-label" style="margin-bottom: 0;">⚙️ {{coreTargetName}} 生理指标配置</text>
        <text class="form-hint" style="margin-top: 0;">已预置科学标准，支持按需自定义微调</text>
      </view>

      <!-- 4.1 当核心计算群为 成年泌乳期生产群 时 -->
      <block wx:if="{{coreTarget === 'lactating'}}">
        <!-- 体重 -->
        <view style="margin-bottom: 20rpx;">
          <view style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10rpx;">
            <text class="sub-form-label">母羊均重 (kg)</text>
            <text class="form-hint" style="margin-top: 0;">范围 25 – 90 kg</text>
          </view>
          <input 
            class="form-input" 
            type="digit" 
            placeholder="例如 50" 
            value="{{bodyWeightKg}}" 
            bindinput="onWeightInput"
          />
          <view class="quick-chips">
            <text class="quick-chip-label">快捷填入：</text>
            <view 
              wx:for="{{['45', '50', '55', '60', '70']}}" 
              wx:key="*this" 
              class="chip-item {{bodyWeightKg === item ? 'chip-active' : ''}}"
              bindtap="quickSetWeight"
              data-val="{{item}}"
            >
              {{item}}kg
            </view>
          </view>
        </view>

        <!-- 日均产奶量 -->
        <view style="margin-bottom: 20rpx;">
          <view style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10rpx;">
            <text class="sub-form-label">日均产奶量 (kg/天)</text>
            <text class="form-hint" style="margin-top: 0;">范围 0.2 – 5.0 kg/天</text>
          </view>
          <input 
            class="form-input" 
            type="digit" 
            placeholder="例如 2.5" 
            value="{{milkKg}}" 
            bindinput="onMilkInput"
          />
          <view class="quick-chips">
            <text class="quick-chip-label">快捷填入：</text>
            <view 
              wx:for="{{['1.5', '2.0', '2.5', '3.0', '3.5']}}" 
              wx:key="*this" 
              class="chip-item {{milkKg === item ? 'chip-active' : ''}}"
              bindtap="quickSetMilk"
              data-val="{{item}}"
            >
              {{item}}kg
            </view>
          </view>
        </view>

        <!-- 乳脂率 -->
        <view>
          <view style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10rpx;">
            <text class="sub-form-label">目标乳脂率 (%, 可选)</text>
            <text class="form-hint" style="margin-top: 0;">预设 4.0%</text>
          </view>
          <input 
            class="form-input" 
            type="digit" 
            placeholder="留空默认 4.0%" 
            value="{{milkFatPercent}}" 
            bindinput="onFatInput"
          />
        </view>
      </block>

      <!-- 4.2 当核心计算群为 青年育成羊 时 -->
      <block wx:elif="{{coreTarget === 'growing'}}">
        <view class="stage-notice-card">
          <text class="stage-notice-icon">🌿</text>
          <view class="stage-notice-text">
            青年育成阶段（3–12月龄）：重点保障骨骼发育与瘤胃容积扩张，粗饲料占干物质比重通常 ≥65%，无需产奶指标。
          </view>
        </view>
        <view style="margin-bottom: 20rpx;">
          <view style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10rpx;">
            <text class="sub-form-label">青年羊均重 (kg)</text>
            <text class="form-hint" style="margin-top: 0;">范围 25 – 60 kg</text>
          </view>
          <input 
            class="form-input" 
            type="digit" 
            placeholder="例如 35" 
            value="{{growingWeightKg}}" 
            bindinput="onGrowingWeightInput"
          />
          <view class="quick-chips">
            <text class="quick-chip-label">快捷填入：</text>
            <view 
              wx:for="{{['25', '30', '35', '40', '45']}}" 
              wx:key="*this" 
              class="chip-item {{growingWeightKg === item ? 'chip-active' : ''}}"
              bindtap="quickSetGrowingWeight"
              data-val="{{item}}"
            >
              {{item}}kg
            </view>
          </view>
        </view>
      </block>

      <!-- 4.3 当核心计算群为 幼年期羔羊 时 -->
      <block wx:elif="{{coreTarget === 'lamb'}}">
        <view class="stage-notice-card">
          <text class="stage-notice-icon">🍼</text>
          <view class="stage-notice-text">
            幼年羔羊阶段（0–3月龄/育肥初期）：处于瘤胃微生物定植关键期，日粮重点满足肌肉与骨骼高增重需要，兼顾高适口性与高易消化性。
          </view>
        </view>
        <view style="margin-bottom: 20rpx;">
          <view style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10rpx;">
            <text class="sub-form-label">羔羊均重 (kg)</text>
            <text class="form-hint" style="margin-top: 0;">范围 25 – 45 kg</text>
          </view>
          <input 
            class="form-input" 
            type="digit" 
            placeholder="例如 28" 
            value="{{lambWeightKg}}" 
            bindinput="onLambWeightInput"
          />
          <view class="quick-chips">
            <text class="quick-chip-label">快捷填入：</text>
            <view 
              wx:for="{{['25', '28', '30', '35']}}" 
              wx:key="*this" 
              class="chip-item {{lambWeightKg === item ? 'chip-active' : ''}}"
              bindtap="quickSetLambWeight"
              data-val="{{item}}"
            >
              {{item}}kg
            </view>
          </view>
        </view>
    </view>
    </block>

    <!-- ======================================================= -->
    <!-- 模式 B：单只个体精准模式 (经典单羊生理参数录入)            -->
    <!-- ======================================================= -->
    <block wx:else>
      <!-- 2. 羊只生理阶段分段选择 -->
      <view class="form-group" style="margin-top: 28rpx;">
        <view class="section-sub-header">
          <text class="form-label" style="margin-bottom: 0;">🐐 羊只生理阶段</text>
          <text class="form-hint" style="margin-top: 0;">切换生理时期，核算个性化营养需要</text>
        </view>
        <view class="class-segmented-bar">
          <view 
            class="class-seg-item {{singleStage === 'lactating' ? 'active' : ''}}" 
            bindtap="selectSingleStage" 
            data-stage="lactating"
          >
            🥛 成年泌乳奶山羊
          </view>
          <view 
            class="class-seg-item {{singleStage === 'maintenance' ? 'active' : ''}}" 
            bindtap="selectSingleStage" 
            data-stage="maintenance"
          >
            🌾 成年维持期羊
          </view>
          <view 
            class="class-seg-item {{singleStage === 'growing' ? 'active' : ''}}" 
            bindtap="selectSingleStage" 
            data-stage="growing"
          >
            🌿 青年育成后备羊
          </view>
        </view>
      </view>

      <!-- 阶段特性说明卡片 -->
      <view wx:if="{{singleStage === 'maintenance'}}" class="stage-notice-card" style="margin-top: 16rpx;">
        <text class="stage-notice-icon">🌾</text>
        <view class="stage-notice-text">
          成年非泌乳维持期（空怀/干奶期）：重点维持机体基础代谢与瘤胃健康，日粮以优质粗饲料为主（粗料比例 ≥70%），无需产奶指标。
        </view>
      </view>
      <view wx:elif="{{singleStage === 'growing'}}" class="stage-notice-card" style="margin-top: 16rpx;">
        <text class="stage-notice-icon">🌿</text>
        <view class="stage-notice-text">
          青年育成阶段（3–12月龄）：重点保障骨骼发育与瘤胃容积扩张，粗饲料占干物质比重通常 ≥65%，强化钙磷与可吸收蛋白沉积。
        </view>
      </view>

      <!-- 3. 单羊体重 -->
      <view class="form-group" style="margin-top: 24rpx;">
        <view style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx;">
          <text class="form-label" style="margin-bottom: 0;">羊只体重 (kg)</text>
          <text class="form-hint" style="margin-top: 0;">范围 25 – 90 kg</text>
        </view>
        <input 
          class="form-input" 
          type="digit" 
          placeholder="例如 50" 
          value="{{singleBodyWeightKg}}" 
          bindinput="onSingleWeightInput"
        />
        <view class="quick-chips">
          <text class="quick-chip-label">快捷填入：</text>
          <view 
            wx:for="{{singleStage === 'growing' ? ['25', '30', '35', '40', '45'] : ['45', '50', '55', '60', '70']}}" 
            wx:key="*this" 
            class="chip-item {{singleBodyWeightKg === item ? 'chip-active' : ''}}"
            bindtap="quickSetSingleWeight"
            data-val="{{item}}"
          >
            {{item}}kg
          </view>
        </view>
      </view>

      <!-- 4. 泌乳期专属字段 (日产奶量 + 目标乳脂率) -->
      <block wx:if="{{singleStage === 'lactating'}}">
        <view class="form-group" style="margin-top: 24rpx;">
          <view style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx;">
            <text class="form-label" style="margin-bottom: 0;">日产奶量 (kg/天)</text>
            <text class="form-hint" style="margin-top: 0;">范围 0.2 – 5.0 kg/天</text>
          </view>
          <input 
            class="form-input" 
            type="digit" 
            placeholder="例如 2.5" 
            value="{{singleMilkKg}}" 
            bindinput="onSingleMilkInput"
          />
          <view class="quick-chips">
            <text class="quick-chip-label">快捷填入：</text>
            <view 
              wx:for="{{['1.5', '2.0', '2.5', '3.0', '3.5']}}" 
              wx:key="*this" 
              class="chip-item {{singleMilkKg === item ? 'chip-active' : ''}}"
              bindtap="quickSetSingleMilk"
              data-val="{{item}}"
            >
              {{item}}kg
            </view>
          </view>
        </view>

        <view class="form-group" style="margin-top: 24rpx;">
          <view style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx;">
            <text class="form-label" style="margin-bottom: 0;">目标乳脂率 (%, 可选)</text>
            <text class="form-hint" style="margin-top: 0;">留空默认 4.0%</text>
          </view>
          <input 
            class="form-input" 
            type="digit" 
            placeholder="留空默认 4.0%" 
            value="{{singleMilkFatPercent}}" 
            bindinput="onSingleFatInput"
          />
        </view>
      </block>
    </block>

    <!-- 错误提示 -->
    <view wx:if="{{errorMessage}}" class="alert-box alert-danger" style="margin-top: 20rpx;">
      {{errorMessage}}
    </view>

    <!-- 下一步按钮 -->
    <view class="btn-row" style="margin-top: 32rpx;">
      <button class="btn-primary" bindtap="handleNext">下一步：选择原料与价格 ➔</button>
    </view>
  </view>

  <!-- 智能硬件控制入口 -->
  <view class="weigh-entry-card" bindtap="goToWeighPage">
    <view class="weigh-entry-left">
      <text class="weigh-entry-icon">⚖️</text>
      <view>
        <text class="weigh-entry-title">自动称量仪器控制台</text>
        <text class="weigh-entry-desc">树莓派 BLE 智能称重 · 远程配料与闸门控制</text>
      </view>
    </view>
    <text class="weigh-entry-arrow">➔</text>
  </view>
</view>
