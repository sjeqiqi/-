/* pages/index/index.wxss */

.class-segmented-bar {
  display: flex;
  background: #f1f5f9;
  border-radius: 16rpx;
  padding: 8rpx;
  gap: 10rpx;
}

.class-seg-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 10rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: #64748b;
  border-radius: 12rpx;
  transition: all 0.25s ease;
}

.class-seg-item.active {
  background: #ffffff;
  color: #059669;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.quick-chips {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 14rpx;
  flex-wrap: wrap;
}

.quick-chip-label {
  font-size: 22rpx;
  color: #94a3b8;
}

.chip-item {
  font-size: 22rpx;
  color: #475569;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 10rpx;
  padding: 6rpx 16rpx;
  transition: all 0.2s ease;
}

.chip-active {
  background: #ecfdf5;
  color: #059669;
  border-color: #a7f3d0;
  font-weight: 600;
}

/* 智能称量仪器入口卡片 */
.weigh-entry-card {
  background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
  border: 1rpx solid #334155;
  border-radius: 24rpx;
  padding: 26rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 6rpx 20rpx rgba(15, 23, 42, 0.12);
  margin-top: 8rpx;
  margin-bottom: 24rpx;
}

.weigh-entry-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.weigh-entry-icon {
  font-size: 42rpx;
}

.weigh-entry-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #f8fafc;
  display: block;
  margin-bottom: 4rpx;
}

.weigh-entry-desc {
  font-size: 22rpx;
  color: #94a3b8;
  display: block;
}

.weigh-entry-arrow {
  font-size: 32rpx;
  color: #34d399;
  font-weight: 700;
}
