/* pages/index/index.wxss */

.section-sub-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.sub-form-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #334155;
}

/* 产区卡片列表 */
.region-cards-grid {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.region-card-item {
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
  transition: all 0.2s ease;
}

.region-card-item.active {
  background: #f0fdf4;
  border-color: #059669;
  box-shadow: 0 4rpx 14rpx rgba(5, 150, 105, 0.12);
}

.region-card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6rpx;
}

.region-card-name {
  font-size: 27rpx;
  font-weight: 700;
  color: #1e293b;
}

.region-card-item.active .region-card-name {
  color: #059669;
}

.region-card-badge {
  font-size: 20rpx;
  color: #64748b;
  background: #e2e8f0;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  font-weight: 600;
}

.region-card-badge.active {
  color: #ffffff;
  background: #059669;
}

.region-card-desc {
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.4;
  display: block;
}

/* 快捷芯片 */
.quick-chips {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 14rpx;
  flex-wrap: wrap;
}

.quick-chip-label {
  font-size: 22rpx;
  color: #94a3b8;
}

.chip-item {
  font-size: 22rpx;
  color: #475569;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 10rpx;
  padding: 6rpx 16rpx;
  transition: all 0.2s ease;
}

.chip-active {
  background: #ecfdf5;
  color: #059669;
  border-color: #a7f3d0;
  font-weight: 600;
}

/* 群体结构展示盒 */
.herd-structure-box {
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 18rpx;
  padding: 10rpx 14rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.herd-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 14rpx;
  border-radius: 14rpx;
  background: #ffffff;
  border: 1.5rpx solid #f1f5f9;
  transition: all 0.2s ease;
}

.herd-row.highlight-core {
  background: #f0fdf4;
  border-color: #6ee7b7;
  box-shadow: 0 2rpx 8rpx rgba(5, 150, 105, 0.12);
}

.herd-row-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex: 1;
}

.herd-info-col {
  flex: 1;
}

.herd-title-badge-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.herd-icon-tag {
  font-size: 36rpx;
}

.herd-stage-title {
  font-size: 25rpx;
  font-weight: 700;
  color: #1e293b;
}

.herd-stage-desc {
  font-size: 20rpx;
  color: #94a3b8;
  display: block;
  margin-top: 2rpx;
}

.core-active-badge {
  font-size: 18rpx;
  color: #047857;
  background: #d1fae5;
  border: 1rpx solid #a7f3d0;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  font-weight: 700;
}

.core-select-btn {
  font-size: 18rpx;
  color: #64748b;
  background: #f1f5f9;
  border: 1rpx solid #e2e8f0;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  font-weight: 500;
}

.herd-row-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
  margin-left: 12rpx;
}

.herd-number-field {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.herd-pct-field {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 6rpx;
}

.herd-count-input {
  width: 96rpx;
  height: 44rpx;
  text-align: right;
  font-size: 26rpx;
  font-weight: 700;
  color: #059669;
  background: #ffffff;
  border: 1rpx solid #cbd5e1;
  border-radius: 8rpx;
  padding: 0 8rpx;
}

.herd-pct-input {
  width: 72rpx;
  height: 38rpx;
  text-align: right;
  font-size: 20rpx;
  font-weight: 600;
  color: #475569;
  background: #ffffff;
  border: 1rpx solid #cbd5e1;
  border-radius: 6rpx;
  padding: 0 6rpx;
}

.herd-unit-label {
  font-size: 21rpx;
  color: #64748b;
  font-weight: 600;
}

.herd-pct-prefix {
  font-size: 19rpx;
  color: #94a3b8;
}

.stage-notice-card {
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-left: 6rpx solid #059669;
  border-radius: 12rpx;
  padding: 16rpx 18rpx;
  margin-bottom: 20rpx;
}

.stage-notice-icon {
  font-size: 30rpx;
  line-height: 1.2;
}

.stage-notice-text {
  font-size: 22rpx;
  color: #475569;
  line-height: 1.5;
  flex: 1;
}

/* 滑块控制器 */
.slider-control-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 0 4rpx;
}

.slider-label {
  font-size: 22rpx;
  color: #64748b;
  white-space: nowrap;
}

.herd-slider {
  flex: 1;
  margin: 0 14rpx;
}

.slider-val-tag {
  font-size: 24rpx;
  font-weight: 700;
  color: #059669;
  min-width: 55rpx;
  text-align: right;
}

/* 智能称量仪器入口卡片 */
.weigh-entry-card {
  background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
  border: 1rpx solid #334155;
  border-radius: 24rpx;
  padding: 26rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 6rpx 20rpx rgba(15, 23, 42, 0.12);
  margin-top: 8rpx;
  margin-bottom: 24rpx;
}

.weigh-entry-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.weigh-entry-icon {
  font-size: 42rpx;
}

.weigh-entry-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #f8fafc;
  display: block;
  margin-bottom: 4rpx;
}

.weigh-entry-desc {
  font-size: 22rpx;
  color: #94a3b8;
  display: block;
}

.weigh-entry-arrow {
  font-size: 32rpx;
  color: #34d399;
  font-weight: 700;
}
