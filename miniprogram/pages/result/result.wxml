<!-- pages/result/result.wxml -->
<view class="container">
  <!-- 顶部步骤条 -->
  <view class="steps-bar">
    <view class="step-item completed">
      <view class="step-icon">✓</view>
      <text class="step-text">羊只信息</text>
    </view>
    <view class="step-item completed">
      <view class="step-icon">✓</view>
      <text class="step-text">原料价格</text>
    </view>
    <view class="step-item active">
      <view class="step-icon">3</view>
      <text class="step-text">配方结果</text>
    </view>
  </view>

  <!-- 1. 🚀 运算求解仪式感加载卡片（约 3 秒专业运筹学求解动效） -->
  <view wx:if="{{loading}}" class="card calc-loading-card">
    <view class="calc-pulse-wrap">
      <view class="calc-center-icon">📐</view>
      <view class="calc-spinner-ring"></view>
    </view>

    <text class="calc-phase-title">{{calculatingPhaseText}}</text>

    <!-- 专业进度条 -->
    <view class="calc-progress-track">
      <view class="calc-progress-bar" style="width: {{calcProgress}}%;"></view>
    </view>

    <!-- 阶段步骤指示 -->
    <view class="calc-phase-tags">
      <text class="phase-tag {{calcProgress >= 20 ? 'tag-active' : ''}}">1. 营养约束矩阵</text>
      <text class="phase-arrow">→</text>
      <text class="phase-tag {{calcProgress >= 60 ? 'tag-active' : ''}}">2. 单纯形法迭代</text>
      <text class="phase-arrow">→</text>
      <text class="phase-tag {{calcProgress >= 90 ? 'tag-active' : ''}}">3. 10g精度复核</text>
    </view>

    <text class="calc-standard-subtitle">
      依据农业农村部《奶山羊饲养标准》（NY/T 2843-2015）
    </text>
  </view>

  <!-- 2. 发生网络或服务端错误 -->
  <view wx:elif="{{error}}" class="card">
    <view class="alert-box alert-danger">
      <text style="font-weight: 700; display: block; margin-bottom: 8rpx;">计算异常</text>
      <text>{{error}}</text>
    </view>
    <view class="btn-row">
      <button class="btn-secondary" bindtap="handleBack">返回修改原料</button>
      <button class="btn-primary" bindtap="handleEditAnimal">修改羊只信息</button>
    </view>
  </view>

  <!-- 3. 不可行 (Infeasible) -->
  <view wx:elif="{{result.status === 'infeasible'}}" class="card">
    <view class="card-title" style="color: #b91c1c;">⚠️ 无法生成可行配方</view>
    <view class="card-subtitle">{{result.detail}}</view>

    <view class="alert-box alert-danger">
      <text style="font-weight: 600; display: block; margin-bottom: 10rpx;">未达标原因：</text>
      <view wx:for="{{result.reasons}}" wx:key="code" style="margin-bottom: 6rpx;">
        • {{item.message}}
      </view>
    </view>

    <view wx:if="{{result.advice}}" style="font-size: 26rpx; color: #475569; margin-bottom: 24rpx;">
      💡 <text style="font-weight: 600;">建议：</text>{{result.advice}}
    </view>

    <view class="btn-row">
      <button class="btn-secondary" bindtap="handleBack">返回修改原料</button>
      <button class="btn-primary" bindtap="handleEditAnimal">修改羊只信息</button>
    </view>
  </view>

  <!-- 4. 正常配方结果展示 (按用户指定黄金顺序排布) -->
  <block wx:else>
    <!-- 近似配比提示（仅在原料过少时） -->
    <view wx:if="{{result.status === 'approximate'}}" class="alert-box alert-warning" style="margin-bottom: 24rpx;">
      <text style="font-size: 28rpx; font-weight: 700; display: block; margin-bottom: 6rpx;">
        ⚠️ 近似参考配比提示
      </text>
      <text style="font-size: 24rpx; line-height: 1.5; display: block;">
        当前勾选原料较少，未能完全覆盖所有营养标准。以下为营养缺口最小的近似参考组合，建议补充粗料或矿物质后再饲喂。
      </text>
    </view>

    <!-- 核心指标卡片矩阵 -->
    <view class="core-grid">
      <view class="metric-card">
        <text class="metric-label">每日喂料总量</text>
        <view class="metric-val-wrap">
          <text class="metric-val">{{result.totals.as_fed_kg}}</text>
          <text class="metric-unit">kg/只</text>
        </view>
      </view>

      <view class="metric-card">
        <text class="metric-label">干物质总量 (DM)</text>
        <view class="metric-val-wrap">
          <text class="metric-val">{{result.totals.dm_kg}}</text>
          <text class="metric-unit">kg/只</text>
        </view>
      </view>

      <view class="metric-card">
        <text class="metric-label">预估日成本</text>
        <view class="metric-val-wrap">
          <text class="metric-val" style="color: #d97706;">{{result.totals.cost_rmb}}</text>
          <text class="metric-unit">元/只</text>
        </view>
      </view>

      <view class="metric-card {{result.qualified ? 'status-pass' : 'status-fail'}}">
        <text class="metric-label">判定结果</text>
        <view class="metric-val-wrap">
          <text class="metric-val">{{result.qualified ? '配方合格' : '近似配比'}}</text>
        </view>
      </view>
    </view>

    <!-- ============================================ -->
    <!-- 顺序 1：每日原料精准配比表 (配比表) -->
    <!-- ============================================ -->
    <view class="card" style="padding: 24rpx;">
      <view class="card-title">
        <text>📋 每日原料精准配比表</text>
        <text style="font-size: 24rpx; font-weight: normal; color: #64748b;">精准至 10g</text>
      </view>

      <scroll-view scroll-x class="table-scroll">
        <view class="table">
          <view class="table-tr table-th">
            <view class="table-td cell-name">原料名称</view>
            <view class="table-td cell-amt">用量(kg/天)</view>
            <view class="table-td cell-price">单价(元/kg)</view>
            <view class="table-td cell-cost">成本(元/天)</view>
          </view>
          <view wx:for="{{result.feed_rows}}" wx:key="feed_id" class="table-tr">
            <view class="table-td cell-name">{{item.name}}</view>
            <view class="table-td cell-amt font-bold">{{item.as_fed_kg}}</view>
            <view class="table-td cell-price">{{item.price_rmb_per_kg}}</view>
            <view class="table-td cell-cost">{{item.cost_rmb}}</view>
          </view>
          <view class="table-tr table-tfoot">
            <view class="table-td cell-name" style="font-weight: 700;">合计</view>
            <view class="table-td cell-amt" style="font-weight: 700;">{{result.totals.as_fed_kg}}</view>
            <view class="table-td cell-price">—</view>
            <view class="table-td cell-cost" style="font-weight: 700; color: #d97706;">{{result.totals.cost_rmb}} 元</view>
          </view>
        </view>
      </scroll-view>
      <text class="form-hint" style="margin-top: 16rpx;">
        总干物质 {{result.totals.dm_kg}} kg/天，占目标采食量 ({{result.dmi_target_kg}} kg) 的 {{result.nutrients.dmi_pct_of_target}}%
      </text>
    </view>

    <!-- ============================================ -->
    <!-- 顺序 2：营养达标复核明细表 (营养达标 - 计算好后直接弹出展示) -->
    <!-- ============================================ -->
    <view class="card" style="padding: 24rpx;">
      <view class="card-title">
        <text>📊 营养达标复核明细</text>
        <text class="badge-green">国家标准复核</text>
      </view>
      <view class="card-subtitle">按 10g 整数化后的最终投喂量逐项科学复核</view>

      <scroll-view scroll-x class="table-scroll">
        <view class="table">
          <view class="table-tr table-th">
            <view class="table-td cell-n-label">指标</view>
            <view class="table-td cell-n-target">标准要求</view>
            <view class="table-td cell-n-actual">实际供给</view>
            <view class="table-td cell-n-pass">达标状态</view>
          </view>
          <view wx:for="{{result.nutrient_status}}" wx:key="key" class="table-tr {{item.pass ? '' : 'row-fail'}}">
            <view class="table-td cell-n-label font-bold">{{item.label}}</view>
            <view class="table-td cell-n-target">{{item.target}}</view>
            <view class="table-td cell-n-actual">{{item.actual !== null ? item.actual : '—'}} {{item.unit}}</view>
            <view class="table-td cell-n-pass">
              <text class="{{item.pass ? 'badge-green' : 'badge-yellow'}}">{{item.pass ? '达标' : '缺口'}}</text>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- ============================================ -->
    <!-- 顺序 3：配方智能解读 (直接用 AI，未生成时显示生成状态) -->
    <!-- ============================================ -->
    <view class="card">
      <view class="card-title" style="margin-bottom: 20rpx;">
        <view style="display: flex; align-items: center; gap: 10rpx;">
          <text>✨ AI 智能科学配方解读</text>
        </view>
        <button 
          wx:if="{{result.status === 'feasible'}}" 
          class="btn-refresh-ai" 
          bindtap="handleManualCalibrate" 
          loading="{{aiLoading}}"
        >
          {{aiLoading ? '正在分析...' : '重新生成'}}
        </button>
      </view>

      <!-- 3.1 AI 正在生成中的优雅加载状态 -->
      <view wx:if="{{aiLoading}}" class="ai-loading-box">
        <view class="spinner" style="width: 44rpx; height: 44rpx; border-width: 4rpx; border-top-color: #4f46e5;"></view>
        <text style="font-size: 28rpx; color: #4338ca; margin-top: 18rpx; font-weight: 600; display: block;">
          DeepSeek 正在结合羊只生理指标生成科学解读…
        </text>
        <text style="font-size: 22rpx; color: #6366f1; margin-top: 6rpx; display: block;">
          配比表与营养表已就绪，解读结果即将呈现
        </text>
      </view>

      <!-- 3.2 AI 生成完成后的解读内容 -->
      <view wx:elif="{{aiResult && aiResult.explanations && aiResult.explanations.length > 0}}" class="ai-box">
        <view class="ai-box-title">
          <text>💡 智能通俗饲喂指导</text>
          <text wx:if="{{aiResult.ai_unavailable}}" class="tag-estimate">本地安全模式</text>
        </view>
        <view wx:for="{{aiResult.explanations}}" wx:key="*this" class="ai-text">
          • {{item}}
        </view>
      </view>

      <!-- 3.3 配方构成亮点 -->
      <view class="insight-block">
        <text class="insight-title">1. 配方构成亮点</text>
        <view class="insight-content">
          <text>• 选用 {{result.ration_insights.used_feed_count}} 种原料，粗饲料占干物质 {{result.ration_insights.forage_dm_pct}}%</text>
          <text wx:if="{{result.ration_insights.top_me_sources && result.ration_insights.top_me_sources.length > 0}}">
            • 主要能量来源：{{result.ration_insights.top_me_sources[0].name}} (贡献 {{result.ration_insights.top_me_sources[0].share_pct}}%)
          </text>
          <text wx:if="{{result.ration_insights.top_cp_sources && result.ration_insights.top_cp_sources.length > 0}}">
            • 主要蛋白来源：{{result.ration_insights.top_cp_sources[0].name}} (贡献 {{result.ration_insights.top_cp_sources[0].share_pct}}%)
          </text>
        </view>
      </view>

      <!-- 3.4 日常饲喂管理建议 -->
      <view class="insight-block" style="border-bottom: none;">
        <text class="insight-title">2. 日常饲喂管理建议</text>
        <view class="insight-content">
          <view wx:for="{{result.management_tips}}" wx:key="*this" style="margin-bottom: 6rpx;">
            • {{item}}
          </view>
        </view>
      </view>
    </view>

    <!-- ============================================ -->
    <!-- 顺序 4：其他（折叠卡片：未达标与贴边指标余量提醒） -->
    <!-- ============================================ -->
    <view class="card collapse-card">
      <view class="collapse-header" bindtap="toggleOtherDetails">
        <view class="collapse-title-row">
          <text class="collapse-title">📌 其他：贴边指标与余量提醒</text>
          <text class="collapse-badge" wx:if="{{(result.ration_insights && result.ration_insights.boundary_flags.length > 0) || (result.violations && result.violations.length > 0)}}">
            {{result.violations && result.violations.length > 0 ? '有未达标项' : '有贴边指标'}}
          </text>
        </view>
        <text class="collapse-arrow {{showOtherDetails ? 'arrow-up' : 'arrow-down'}}">
          {{showOtherDetails ? '收起 ▲' : '展开 ▼'}}
        </text>
      </view>

      <!-- 折叠展开区 -->
      <view wx:if="{{showOtherDetails}}" class="collapse-body">
        <!-- 未达标项（仅在 approximate 下展示） -->
        <view wx:if="{{result.status === 'approximate' && result.violations && result.violations.length > 0}}" style="margin-bottom: 20rpx;">
          <text class="sub-section-title" style="color: #b91c1c;">未达标指标及缺口</text>
          <view class="violations-list">
            <view wx:for="{{result.violations}}" wx:key="code" class="violation-item">
              ❌ {{item.message}}
            </view>
          </view>
          <text class="form-hint" style="margin-top: 10rpx;">{{result.advice}}</text>
        </view>

        <!-- 贴边指标余量提醒 -->
        <view wx:if="{{result.ration_insights && result.ration_insights.boundary_flags.length > 0}}" style="margin-bottom: 20rpx;">
          <text class="sub-section-title" style="color: #b45309;">贴边指标余量说明（已达标，余量较窄）</text>
          <view class="boundary-flags-list">
            <view wx:for="{{result.ration_insights.boundary_flags}}" wx:key="code" class="flag-item">
              <text class="flag-label">{{item.label}}：</text>
              <text class="flag-detail">{{item.detail}}</text>
            </view>
          </view>
          <text class="form-hint" style="margin-top: 10rpx;">
            贴边指标表示该营养素已合格达标但刚好压线，若实际原料批次发生变化建议复测。
          </text>
        </view>

        <!-- 优化机理说明 -->
        <view style="margin-top: 16rpx;">
          <text class="sub-section-title">优化算法机理</text>
          <text class="form-hint" style="line-height: 1.5; color: #64748b;">
            系统严格按照《奶山羊饲养标准》（NY/T 2843-2015），在全项营养约束边界内使用单纯形法求解每日最低成本投喂组合。
          </text>
        </view>
      </view>
    </view>

    <!-- 底部按钮 -->
    <view class="btn-row">
      <button class="btn-secondary" bindtap="handleBack">调整原料与价格</button>
      <button class="btn-primary" bindtap="handleEditAnimal">重新填写羊只</button>
    </view>

    <!-- 底部服务协议与免责声明入口 -->
    <view class="footer-agreement" bindtap="openAgreementModal">
      <text class="agreement-text">📖 依据《奶山羊饲养标准》（NY/T 2843-2015）计算</text>
      <text class="agreement-link">查看《用户服务协议与科学免责声明》</text>
    </view>
  </block>

  <!-- 用户服务协议与科学免责声明弹窗 -->
  <view wx:if="{{showAgreementModal}}" class="modal-mask" bindtap="closeAgreementModal">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-header">
        <text class="modal-title">用户服务协议与科学免责声明</text>
        <text class="modal-close" bindtap="closeAgreementModal">✕</text>
      </view>
      <scroll-view scroll-y class="modal-body">
        <view class="disclaimer-section">
          <text class="disclaimer-title">一、科学模型与计算依据</text>
          <text class="disclaimer-p">
            本系统日粮配比模型严格依照农业农村部《奶山羊饲养标准》（NY/T 2843-2015）及《中国饲料成分及营养价值表》进行线性规划数学优化求解。
          </text>
        </view>

        <view class="disclaimer-section">
          <text class="disclaimer-title">二、原料数据与批次差异说明</text>
          <text class="disclaimer-p">
            系统内置的原料营养成分为公开科研数据库的行业参考平均值。不同产地、不同批次原料的实际营养成分可能存在差异；如您具备原料检测化验报告，建议在“原料选择”页录入实测值以获得更精准的配方结果。
          </text>
        </view>

        <view class="disclaimer-section">
          <text class="disclaimer-title">三、换料过渡与饲喂管理建议</text>
          <text class="disclaimer-p">
            更换日粮或调整配方时应保持 5–7 天逐步过渡，避免突然更换导致瘤胃菌群紊乱；在日常饲喂中请持续观察羊只采食、反刍、体况及产奶表现。
          </text>
        </view>

        <view class="disclaimer-section">
          <text class="disclaimer-title">四、AI 辅助解读性质声明</text>
          <text class="disclaimer-p">
            本工具中的 AI 解读模块基于确定性计算结果进行通俗化辅助语言转写，旨在帮助养殖户通俗理解指标，不改变底层计算克数与营养达标判定；本工具不作疾病诊断、医疗方案或产量承诺，特殊异常情况建议咨询畜牧兽医专业人员。
          </text>
        </view>
      </scroll-view>
      <view class="modal-footer">
        <button class="btn-primary" style="height: 80rpx; line-height: 80rpx; font-size: 28rpx;" bindtap="closeAgreementModal">
          我已阅读并同意
        </button>
      </view>
    </view>
  </view>
</view>
