<!-- pages/result/result.wxml -->
<view class="container">
  <!-- 顶部步骤条 -->
  <view class="steps-bar">
    <view class="step-item completed">
      <view class="step-icon">✓</view>
      <text class="step-text">牧场信息</text>
    </view>
    <view class="step-item completed">
      <view class="step-icon">✓</view>
      <text class="step-text">原料价格</text>
    </view>
    <view class="step-item active">
      <view class="step-icon">3</view>
      <text class="step-text">配方结果</text>
    </view>
  </view>

  <!-- ======================================================== -->
  <!-- 1. DeepSeek 智能解读生成中 · 实时流式思考推演终端 -->
  <!-- ======================================================== -->
  <view wx:if="{{loading}}" class="thinking-terminal-card">
    <view class="terminal-header">
      <view class="terminal-header-left">
        <view class="terminal-dots">
          <view class="terminal-dot dot-red"></view>
          <view class="terminal-dot dot-yellow"></view>
          <view class="terminal-dot dot-green"></view>
        </view>
        <view class="terminal-title-wrap">
          <text class="terminal-title">DeepSeek-Reasoner</text>
          <text class="terminal-badge-thinking">
            <text class="pulse-thinking-circle"></text>
            深度思考中 ({{thinkingDuration}})
          </text>
        </view>
      </view>
      <view class="terminal-skip-btn" bindtap="skipThinking">
        ⏩ 跳过思考
      </view>
    </view>

    <!-- 思考阶段推进器 -->
    <view class="terminal-stages-bar">
      <view class="stage-tag {{currentThinkingStage >= 1 ? 'active' : ''}}">
        <text class="stage-icon">{{currentThinkingStage > 1 ? '✓' : '1'}}</text>
        <text>需要量解析</text>
      </view>
      <view class="stage-divider {{currentThinkingStage >= 2 ? 'active' : ''}}"></view>
      <view class="stage-tag {{currentThinkingStage >= 2 ? 'active' : ''}}">
        <text class="stage-icon">{{currentThinkingStage > 2 ? '✓' : '2'}}</text>
        <text>产区行情约束</text>
      </view>
      <view class="stage-divider {{currentThinkingStage >= 3 ? 'active' : ''}}"></view>
      <view class="stage-tag {{currentThinkingStage >= 3 ? 'active' : ''}}">
        <text class="stage-icon">{{currentThinkingStage > 3 ? '✓' : '3'}}</text>
        <text>反刍健康校验</text>
      </view>
      <view class="stage-divider {{currentThinkingStage >= 4 ? 'active' : ''}}"></view>
      <view class="stage-tag {{currentThinkingStage >= 4 ? 'active' : ''}}">
        <text class="stage-icon">{{currentThinkingStage >= 4 ? '✓' : '4'}}</text>
        <text>全场收敛求解</text>
      </view>
    </view>

    <!-- 打字机流式推演控制台 -->
    <scroll-view scroll-y class="terminal-scroll-area" scroll-top="{{terminalScrollTop}}">
      <view class="terminal-console-body">
        <text class="terminal-text">{{streamingThinkingText}}</text>
        <text class="terminal-cursor">▌</text>
      </view>
    </scroll-view>

    <view class="terminal-footer">
      <view class="terminal-status-info">
        <text class="terminal-hint">正在执行反刍营养学与线性规划单纯形法收敛计算…</text>
      </view>
    </view>
  </view>

  <!-- 2. 发生网络或服务端错误 -->
  <view wx:elif="{{error}}" class="card">
    <view class="alert-box alert-danger">
      <text style="font-weight: 700; display: block; margin-bottom: 8rpx;">计算异常</text>
      <text>{{error}}</text>
    </view>
    <view class="btn-row">
      <button class="btn-secondary" bindtap="handleBack">返回修改原料</button>
      <button class="btn-primary" bindtap="handleEditAnimal">修改牧场信息</button>
    </view>
  </view>

  <!-- 3. 不可行 (Infeasible) -->
  <view wx:elif="{{result.status === 'infeasible'}}" class="card">
    <view class="card-title" style="color: #b91c1c;">⚠️ 无法生成可行配方</view>
    <view class="card-subtitle">{{result.detail}}</view>

    <view class="alert-box alert-danger">
      <text style="font-weight: 600; display: block; margin-bottom: 10rpx;">未达标原因：</text>
      <view wx:for="{{result.reasons}}" wx:key="code" style="margin-bottom: 6rpx;">
        • {{item.message}}
      </view>
    </view>

    <view wx:if="{{result.advice}}" style="font-size: 26rpx; color: #475569; margin-bottom: 24rpx;">
      💡 <text style="font-weight: 600;">建议：</text>{{result.advice}}
    </view>

    <view class="btn-row">
      <button class="btn-secondary" bindtap="handleBack">返回修改原料</button>
      <button class="btn-primary" bindtap="handleEditAnimal">修改牧场信息</button>
    </view>
  </view>

  <!-- 4. 正常配方结果展示 (排版黄金原则：文字与解读前置，详细数据与表格后置) -->
  <block wx:else>

    <!-- 近似配比提示（仅在原料过少时） -->
    <view wx:if="{{result.status === 'approximate'}}" class="alert-box alert-warning" style="margin-bottom: 24rpx;">
      <text style="font-size: 28rpx; font-weight: 700; display: block; margin-bottom: 6rpx;">
        ⚠️ 近似参考配比提示
      </text>
      <text style="font-size: 24rpx; line-height: 1.5; display: block;">
        当前勾选原料较少，未能完全覆盖所有营养标准。以下为营养缺口最小的近似参考组合，建议补充粗料或矿物质后再饲喂。
      </text>
    </view>

    <!-- ======================================================== -->
    <!-- 顶层 · 智能推理与思考过程（DeepSeek Thinking Process） -->
    <!-- ======================================================== -->
    <view class="card thinking-card">
      <view class="thinking-header" bindtap="toggleThinking">
        <view class="thinking-title-wrap">
          <view class="thinking-badge-icon">🧠</view>
          <view>
            <view style="display: flex; align-items: center; gap: 10rpx;">
              <text class="thinking-title">DeepSeek 深度推理与思考链路</text>
              <text class="tag-reasoning">Thinking Process</text>
            </view>
            <text class="thinking-subtitle">已完成思考推演（耗时 {{thinkingDuration}}），点击查阅思维链全文</text>
          </view>
        </view>
        <view class="thinking-toggle-btn">
          <text class="thinking-arrow">{{showThinking ? '收起 ▲' : '展开查看思维链 ▼'}}</text>
        </view>
      </view>

      <!-- 思考过程展开区域 -->
      <view wx:if="{{showThinking}}" class="thinking-body">
        <view class="thinking-steps-list">
          <view wx:for="{{thinkingSteps}}" wx:key="step" class="thinking-step-row">
            <view class="step-num-badge">{{item.step}}</view>
            <view class="step-content-wrap">
              <text class="step-item-title">{{item.title}}</text>
              <text class="step-item-desc">{{item.desc}}</text>
            </view>
          </view>
        </view>

        <!-- 完整思维链推演文本控制台 -->
        <view class="raw-thinking-box">
          <text class="raw-thinking-title">🖥️ 完整思维链推演记录：</text>
          <text class="raw-thinking-content">{{fullThinkingText}}</text>
        </view>

        <!-- 原始推理文本（若接口返回特别内容） -->
        <view wx:if="{{rawThinkingProcess && rawThinkingProcess !== fullThinkingText}}" class="raw-thinking-box" style="margin-top: 14rpx;">
          <text class="raw-thinking-title">大模型原始 Reasoning 文本：</text>
          <text class="raw-thinking-content">{{rawThinkingProcess}}</text>
        </view>
      </view>
    </view>

    <!-- ======================================================== -->
    <!-- 第二层 · 配方亮点与专家解读 (首屏核心视觉区) -->
    <!-- ======================================================== -->
    <view class="card" style="padding: 24rpx;">
      <view class="ai-card-header">
        <view class="ai-card-title">
          <text class="ai-sparkle-icon">✨</text>
          <text class="ai-title-text">AI 专家综合决策解读</text>
        </view>
        <button 
          wx:if="{{result.status === 'feasible'}}" 
          class="btn-refresh-ai" 
          bindtap="handleManualCalibrate" 
          loading="{{aiLoading}}"
        >
          {{aiLoading ? '分析中' : '重新生成'}}
        </button>
      </view>

      <!-- 手动重新分析时的局部加载状态 -->
      <view wx:if="{{aiLoading}}" class="ai-loading-box">
        <view class="spinner" style="width: 44rpx; height: 44rpx; border-width: 4rpx; border-top-color: #4f46e5;"></view>
        <text style="font-size: 26rpx; color: #4338ca; margin-top: 14rpx; font-weight: 600; display: block;">
          正在重新生成 DeepSeek 智能解读…
        </text>
      </view>

      <!-- AI 生成完成后的解读内容 -->
      <view wx:elif="{{aiResult && aiResult.explanations && aiResult.explanations.length > 0}}" class="ai-box" style="margin-top: 14rpx;">
        <view class="ai-box-title">
          <text>💡 智能通俗饲喂指导</text>
          <text wx:if="{{aiResult.ai_unavailable}}" class="tag-estimate">科学复核模式</text>
        </view>
        <view wx:for="{{aiResult.explanations}}" wx:key="*this" class="ai-text">
          • {{item}}
        </view>
      </view>

      <!-- 配方核心优势亮点 (精粗比、供能/蛋白主力) -->
      <view class="insight-block" style="margin-top: 20rpx;">
        <text class="insight-title">🌟 配方构成亮点与产奶潜力</text>
        <view class="insight-content">
          <text>• 选用 {{result.ration_insights.used_feed_count}} 种原料，粗饲料占干物质 {{result.ration_insights.forage_dm_pct}}%（精粗比维持在反刍安全黄金区间）</text>
          <text wx:if="{{result.ration_insights.top_me_sources && result.ration_insights.top_me_sources.length > 0}}">
            • 核心能量源：{{result.ration_insights.top_me_sources[0].name}} (贡献率 {{result.ration_insights.top_me_sources[0].share_pct}}%)
          </text>
          <text wx:if="{{result.ration_insights.top_cp_sources && result.ration_insights.top_cp_sources.length > 0}}">
            • 核心蛋白源：{{result.ration_insights.top_cp_sources[0].name}} (贡献率 {{result.ration_insights.top_cp_sources[0].share_pct}}%)
          </text>
          <text>• 成本控制亮点：在严格满足国家标准的前提下，达成全场最低成本配比</text>
        </view>
      </view>

      <!-- 日常饲喂管理建议 -->
      <view class="insight-block" style="border-bottom: none; margin-top: 16rpx;">
        <text class="insight-title">📋 牧场日常饲喂管理建议</text>
        <view class="insight-content">
          <view wx:for="{{result.management_tips}}" wx:key="*this" style="margin-bottom: 6rpx;">
            • {{item}}
          </view>
        </view>
      </view>
    </view>

    <!-- ======================================================== -->
    <!-- 第三层 · 四大宏观指标看板 -->
    <!-- ======================================================== -->
    <view class="core-grid">
      <view class="metric-card">
        <text class="metric-label">每日饲喂总量</text>
        <view class="metric-val-wrap">
          <text class="metric-val">{{result.totals.as_fed_kg}}</text>
          <text class="metric-unit">kg/只</text>
        </view>
      </view>

      <view class="metric-card">
        <text class="metric-label">干物质总量 (DM)</text>
        <view class="metric-val-wrap">
          <text class="metric-val">{{result.totals.dm_kg}}</text>
          <text class="metric-unit">kg/只</text>
        </view>
      </view>

      <view class="metric-card">
        <text class="metric-label">预估日成本</text>
        <view class="metric-val-wrap">
          <text class="metric-val" style="color: #d97706;">{{result.totals.cost_rmb}}</text>
          <text class="metric-unit">元/只</text>
        </view>
      </view>

      <view class="metric-card {{result.qualified ? 'status-pass' : 'status-fail'}}">
        <text class="metric-label">判定结果</text>
        <view class="metric-val-wrap">
          <text class="metric-val">{{result.qualified ? '配方合格' : '近似配比'}}</text>
        </view>
      </view>
    </view>

    <!-- ======================================================== -->
    <!-- 底层 · 原料配比与全场总用量详情表 -->
    <!-- ======================================================== -->
    <view class="card" style="padding: 24rpx;">
      <view class="card-title-row">
        <view>
          <text class="card-title-text">📋 原料配比与全场总用量详情表</text>
          <text class="card-title-sub">涵盖单羊、百只及全场生产群每日采购配料总用量</text>
        </view>
        <text class="badge-green">多维联动</text>
      </view>

      <!-- 全场总用量汇总横幅 -->
      <view class="flock-summary-banner">
        <view class="flock-summary-title">
          <text wx:if="{{result.flock_totals.calc_mode === 'single'}}">🐐 单只精准测算（{{result.flock_totals.core_name}}）每日原料消耗与日粮成本：</text>
          <text wx:else>🐑 全场核心计算群（{{result.flock_totals.core_count}} 只 {{result.flock_totals.core_name || '成年泌乳羊'}}）每日原料总消耗：</text>
        </view>
        <view class="flock-summary-numbers">
          <view class="flock-num-item">
            <text wx:if="{{result.flock_totals.calc_mode === 'single'}}" class="flock-num-val">{{result.totals.as_fed_kg}}</text>
            <text wx:else class="flock-num-val">{{result.flock_totals.as_fed_daily_kg}}</text>
            <text wx:if="{{result.flock_totals.calc_mode === 'single'}}" class="flock-num-unit">kg/只/天 (干物质 {{result.totals.dm_kg}} kg)</text>
            <text wx:else class="flock-num-unit">kg/天 (约 {{result.flock_totals.as_fed_daily_ton}} 吨)</text>
          </view>
          <view class="flock-num-item" style="text-align: right;">
            <text wx:if="{{result.flock_totals.calc_mode === 'single'}}" class="flock-num-val" style="color: #d97706;">¥{{result.totals.cost_rmb}}</text>
            <text wx:else class="flock-num-val" style="color: #d97706;">¥{{result.flock_totals.cost_daily_rmb}}</text>
            <text wx:if="{{result.flock_totals.calc_mode === 'single'}}" class="flock-num-unit">单只羊日粮成本</text>
            <text wx:else class="flock-num-unit">核心群日粮总成本</text>
          </view>
        </view>
      </view>

      <!-- 多维度单位数据表格 -->
      <scroll-view scroll-x class="table-scroll" style="margin-top: 18rpx;">
        <view class="table">
          <view class="table-tr table-th">
            <view class="table-td cell-name">原料名称</view>
            <view class="table-td cell-amt">单羊(kg/只)</view>
            <view class="table-td cell-amt">百只(kg/百只)</view>
            <view class="table-td cell-flock">全场日用量</view>
            <view class="table-td cell-price">单价(元/kg)</view>
          </view>
          <view wx:for="{{result.feed_rows}}" wx:key="feed_id" class="table-tr">
            <view class="table-td cell-name font-bold">{{item.name}}</view>
            <view class="table-td cell-amt">{{item.as_fed_kg}}</view>
            <view class="table-td cell-amt" style="color: #0284c7;">{{item.per_hundred_kg}}</view>
            <view class="table-td cell-flock font-bold" style="color: #059669;">{{item.flock_daily_display}}</view>
            <view class="table-td cell-price">{{item.price_rmb_per_kg}}</view>
          </view>
          <view class="table-tr table-tfoot">
            <view class="table-td cell-name" style="font-weight: 700;">合计</view>
            <view class="table-td cell-amt" style="font-weight: 700;">{{result.totals.as_fed_kg}}</view>
            <view class="table-td cell-amt" style="font-weight: 700; color: #0284c7;">—</view>
            <view class="table-td cell-flock" style="font-weight: 700; color: #059669;">{{result.flock_totals.as_fed_daily_kg}} kg</view>
            <view class="table-td cell-price" style="font-weight: 700; color: #d97706;">{{result.totals.cost_rmb}}元/只</view>
          </view>
        </view>
      </scroll-view>

      <text class="form-hint" style="margin-top: 14rpx;">
        总干物质 {{result.totals.dm_kg}} kg/只/天，占目标采食量 ({{result.dmi_target_kg}} kg) 的 {{result.nutrients.dmi_pct_of_target}}%，符合反刍胃容积规律。
      </text>

      <!-- 智能硬件称量入口 -->
      <view style="margin-top: 22rpx;">
        <button class="btn-weigh-link" bindtap="handleOpenWeighStation">
          ⚖️ 启动自动称量仪器精准投喂 ➔
        </button>
      </view>
    </view>

    <!-- ======================================================== -->
    <!-- 附录 · 营养达标复核明细表 (按 10g 整数化逐项科学复核) -->
    <!-- ======================================================== -->
    <view class="card" style="padding: 24rpx;">
      <view class="card-title">
        <text>📊 营养达标复核明细表</text>
        <text class="badge-green">国家行业标准复核</text>
      </view>
      <view class="card-subtitle">依照 NY/T 2835 及 NY/T 816，按 10g 整数化投喂量逐项复核</view>

      <scroll-view scroll-x class="table-scroll">
        <view class="table">
          <view class="table-tr table-th">
            <view class="table-td cell-n-label">营养指标</view>
            <view class="table-td cell-n-target">标准要求</view>
            <view class="table-td cell-n-actual">实际供给</view>
            <view class="table-td cell-n-pass">达标状态</view>
          </view>
          <view wx:for="{{result.nutrient_status}}" wx:key="key" class="table-tr {{item.pass ? '' : 'row-fail'}}">
            <view class="table-td cell-n-label font-bold">{{item.label}}</view>
            <view class="table-td cell-n-target">{{item.target}}</view>
            <view class="table-td cell-n-actual">{{item.actual !== null ? item.actual : '—'}} {{item.unit}}</view>
            <view class="table-td cell-n-pass">
              <text class="{{item.pass ? 'badge-green' : 'badge-yellow'}}">{{item.pass ? '达标' : '缺口'}}</text>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- ======================================================== -->
    <!-- 其他：贴边指标与余量提醒（折叠） -->
    <!-- ======================================================== -->
    <view class="card collapse-card">
      <view class="collapse-header" bindtap="toggleOtherDetails">
        <view class="collapse-title-row">
          <text class="collapse-title">📌 其他：贴边指标与算法机理说明</text>
          <text class="collapse-badge" wx:if="{{(result.ration_insights && result.ration_insights.boundary_flags.length > 0) || (result.violations && result.violations.length > 0)}}">
            {{result.violations && result.violations.length > 0 ? '有未达标项' : '有贴边指标'}}
          </text>
        </view>
        <text class="collapse-arrow {{showOtherDetails ? 'arrow-up' : 'arrow-down'}}">
          {{showOtherDetails ? '收起 ▲' : '展开 ▼'}}
        </text>
      </view>

      <!-- 折叠展开区 -->
      <view wx:if="{{showOtherDetails}}" class="collapse-body">
        <!-- 未达标项（仅在 approximate 下展示） -->
        <view wx:if="{{result.status === 'approximate' && result.violations && result.violations.length > 0}}" style="margin-bottom: 20rpx;">
          <text class="sub-section-title" style="color: #b91c1c;">未达标指标及缺口</text>
          <view class="violations-list">
            <view wx:for="{{result.violations}}" wx:key="code" class="violation-item">
              ❌ {{item.message}}
            </view>
          </view>
          <text class="form-hint" style="margin-top: 10rpx;">{{result.advice}}</text>
        </view>

        <!-- 贴边指标余量提醒 -->
        <view wx:if="{{result.ration_insights && result.ration_insights.boundary_flags.length > 0}}" style="margin-bottom: 20rpx;">
          <text class="sub-section-title" style="color: #b45309;">贴边指标余量说明（已达标，余量较窄）</text>
          <view class="boundary-flags-list">
            <view wx:for="{{result.ration_insights.boundary_flags}}" wx:key="code" class="flag-item">
              <text class="flag-label">{{item.label}}：</text>
              <text class="flag-detail">{{item.detail}}</text>
            </view>
          </view>
          <text class="form-hint" style="margin-top: 10rpx;">
            贴边指标表示该营养素已合格达标但刚好压线，若实际原料批次发生变化建议复测。
          </text>
        </view>

        <!-- 优化机理说明 -->
        <view style="margin-top: 16rpx;">
          <text class="sub-section-title">优化算法机理</text>
          <text class="form-hint" style="line-height: 1.5; color: #64748b;">
            系统严格按照《奶山羊饲养管理技术规范》（NY/T 2835-2015）及《肉羊营养需要量》（NY/T 816-2021），在全项营养约束边界内使用单纯形法求解全场规模化最低成本投喂组合。
          </text>
        </view>
      </view>
    </view>

    <!-- 底部按钮 -->
    <view class="btn-row">
      <button class="btn-secondary" bindtap="handleBack">调整原料与价格</button>
      <button class="btn-primary" bindtap="handleEditAnimal">重新填写牧场</button>
    </view>

    <!-- 底部服务协议与免责声明入口 -->
    <view class="footer-agreement" bindtap="openAgreementModal">
      <text class="agreement-text">📖 依据《奶山羊饲养管理技术规范》（NY/T 2835-2015）及营养标准计算</text>
      <text class="agreement-link">查看《用户服务协议与科学免责声明》</text>
    </view>
  </block>

  <!-- 用户服务协议与科学免责声明弹窗 -->
  <view wx:if="{{showAgreementModal}}" class="modal-mask" bindtap="closeAgreementModal">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-header">
        <text class="modal-title">用户服务协议与科学免责声明</text>
        <text class="modal-close" bindtap="closeAgreementModal">✕</text>
      </view>
      <scroll-view scroll-y class="modal-body">
