/* pages/result/result.wxss */

/* 🚀 专业运算求解 3 秒仪式感加载卡片 */
.calc-loading-card {
  text-align: center;
  padding: 80rpx 36rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
  border: 2rpx solid #e2e8f0;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 32rpx rgba(15, 23, 42, 0.06);
}

.calc-pulse-wrap {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  margin: 0 auto 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.calc-center-icon {
  font-size: 56rpx;
  z-index: 2;
}

.calc-spinner-ring {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border: 6rpx solid #e2e8f0;
  border-top-color: #10b981;
  border-right-color: #059669;
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
  box-sizing: border-box;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.calc-phase-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
  display: block;
  min-height: 48rpx;
  line-height: 1.5;
  margin-bottom: 30rpx;
  transition: all 0.3s ease;
}

.calc-progress-track {
  width: 100%;
  height: 14rpx;
  background: #e2e8f0;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 28rpx;
}

.calc-progress-bar {
  height: 100%;
  background: linear-gradient(90deg, #10b981 0%, #059669 100%);
  border-radius: 20rpx;
  transition: width 0.8s ease;
}

.calc-phase-tags {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-bottom: 28rpx;
  flex-wrap: wrap;
}

.phase-tag {
  font-size: 22rpx;
  color: #94a3b8;
  background: #f1f5f9;
  padding: 6rpx 14rpx;
  border-radius: 10rpx;
  transition: all 0.3s ease;
}

.phase-tag.tag-active {
  color: #059669;
  background: #ecfdf5;
  border: 1rpx solid #a7f3d0;
  font-weight: 600;
}

.phase-arrow {
  font-size: 20rpx;
  color: #cbd5e1;
}

.calc-standard-subtitle {
  font-size: 22rpx;
  color: #94a3b8;
  display: block;
}

/* 核心指标 2x2 宫格 */
.core-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.metric-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  border: 1rpx solid #e2e8f0;
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.03);
}

.metric-label {
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 8rpx;
  display: block;
}

.metric-val-wrap {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.metric-val {
  font-size: 38rpx;
  font-weight: 700;
  color: #0f172a;
}

.metric-unit {
  font-size: 22rpx;
  color: #94a3b8;
}

.status-pass {
  background: #ecfdf5;
  border-color: #a7f3d0;
}

.status-pass .metric-val {
  color: #059669;
}

.status-fail {
  background: #fffbeb;
  border-color: #fde68a;
}

.status-fail .metric-val {
  color: #d97706;
}

/* 响应式表格 */
.table-scroll {
  width: 100%;
  margin-top: 16rpx;
}

.table {
  display: table;
  width: 100%;
  min-width: 600rpx;
  border-collapse: collapse;
}

.table-tr {
  display: table-row;
  border-bottom: 1rpx solid #f1f5f9;
}

.table-th {
  background: #f8fafc;
  font-weight: 600;
  color: #475569;
}

.table-td {
  display: table-cell;
  padding: 16rpx 12rpx;
  font-size: 26rpx;
  vertical-align: middle;
}

.cell-name { width: 35%; }
.cell-amt { width: 25%; }
.cell-price { width: 20%; }
.cell-cost { width: 20%; }

.cell-n-label { width: 30%; }
.cell-n-target { width: 28%; font-size: 24rpx; }
.cell-n-actual { width: 24%; font-size: 24rpx; }
.cell-n-pass { width: 18%; text-align: center; }

.font-bold {
  font-weight: 700;
  color: #0f172a;
}

.table-tfoot {
  background: #f8fafc;
  border-top: 2rpx solid #e2e8f0;
}

.row-fail {
  background: #fffbeb;
}

/* AI 解读盒与头部按钮 */
.ai-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  width: 100%;
}

.ai-card-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 1;
}

.ai-sparkle-icon {
  font-size: 32rpx;
  line-height: 1;
}

.ai-title-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
  white-space: nowrap;
  line-height: 1.2;
}

.btn-refresh-ai {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  font-size: 22rpx;
  font-weight: 600;
  color: #4f46e5;
  background: #eef2ff;
  border: 1rpx solid #c7d2fe;
  border-radius: 24rpx;
  height: 52rpx;
  line-height: 1 !important;
  padding: 0 20rpx !important;
  margin: 0 !important;
  flex-shrink: 0;
}

.btn-refresh-ai::after {
  border: none;
}

.ai-loading-box {
  background: #f5f3ff;
  border: 1rpx dashed #c7d2fe;
  border-radius: 20rpx;
  padding: 36rpx 20rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.ai-box {
  background: linear-gradient(135deg, #f5f3ff 0%, #ede9fe 100%);
  border: 1rpx solid #ddd6fe;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(79, 70, 229, 0.06);
}

.ai-box-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  font-weight: 700;
  color: #4338ca;
  margin-bottom: 12rpx;
}

.ai-text {
  font-size: 26rpx;
  color: #3730a3;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

/* 解读分块 */
.insight-block {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.insight-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
  display: block;
  margin-bottom: 10rpx;
}

.insight-content {
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.6;
}

/* 顺序 4：折叠卡片（其他：贴边与未达标指标） */
.collapse-card {
  padding: 28rpx 32rpx;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
}

.collapse-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}

.collapse-title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.collapse-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #334155;
  line-height: 1;
  display: flex;
  align-items: center;
}

.collapse-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  background: #fef3c7;
  color: #b45309;
  border: 1rpx solid #fde68a;
  padding: 6rpx 14rpx;
  border-radius: 10rpx;
  line-height: 1;
  vertical-align: middle;
}

.collapse-arrow {
  display: inline-flex;
  align-items: center;
  font-size: 26rpx;
  color: #4f46e5;
  font-weight: 600;
  line-height: 1;
}

.collapse-body {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f1f5f9;
}

.sub-section-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1e293b;
  display: block;
  margin-bottom: 10rpx;
}

.violations-list {
  background: #fef2f2;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
}

.violation-item {
  font-size: 25rpx;
  color: #991b1b;
  margin-bottom: 8rpx;
}

.boundary-flags-list {
  background: #fffbeb;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
}

.flag-item {
  font-size: 24rpx;
  color: #92400e;
  margin-bottom: 8rpx;
  line-height: 1.4;
}

.flag-label {
  font-weight: 600;
}

/* 底部协议入口 */
.footer-agreement {
  text-align: center;
  padding: 30rpx 20rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.agreement-text {
  font-size: 22rpx;
  color: #94a3b8;
}

.agreement-link {
  font-size: 24rpx;
  color: #4f46e5;
  text-decoration: underline;
}

/* 免责声明弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.modal-content {
  background: #ffffff;
  width: 100%;
  max-height: 75vh;
  border-top-left-radius: 28rpx;
  border-top-right-radius: 28rpx;
  padding: 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  border-bottom: 1rpx solid #e2e8f0;
  padding-bottom: 16rpx;
}

.modal-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.modal-close {
  font-size: 32rpx;
  color: #94a3b8;
  padding: 0 10rpx;
}

.modal-body {
  flex: 1;
  max-height: 50vh;
  padding-right: 8rpx;
}

.disclaimer-section {
  margin-bottom: 24rpx;
}

.disclaimer-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #334155;
  display: block;
  margin-bottom: 8rpx;
}

.disclaimer-p {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.6;
  display: block;
}

.modal-footer {
  margin-top: 24rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #e2e8f0;
}
