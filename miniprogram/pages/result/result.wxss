/* pages/result/result.wxss */

/* 加载动画 */
.spinner {
  width: 68rpx;
  height: 68rpx;
  border: 6rpx solid #e2e8f0;
  border-top-color: #10b981;
  border-radius: 50%;
  margin: 0 auto;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ========================================================
   DeepSeek 深度思考实时流式终端卡片
======================================================== */
.thinking-terminal-card {
  background: #090d16;
  border: 1.5rpx solid #38bdf8;
  border-radius: 28rpx;
  padding: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(2, 6, 23, 0.4), 0 0 20rpx rgba(56, 189, 248, 0.15);
  margin-bottom: 24rpx;
}

.terminal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid #1e293b;
}

.terminal-header-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.terminal-dots {
  display: flex;
  gap: 10rpx;
}

.terminal-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
}

.dot-red { background: #ef4444; }
.dot-yellow { background: #f59e0b; }
.dot-green { background: #10b981; }

.terminal-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.terminal-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #f8fafc;
  font-family: monospace;
}

.terminal-badge-thinking {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 20rpx;
  color: #38bdf8;
  background: rgba(56, 189, 248, 0.15);
  border: 1rpx solid rgba(56, 189, 248, 0.35);
  border-radius: 20rpx;
  padding: 2rpx 14rpx;
  font-family: monospace;
}

.pulse-thinking-circle {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #38bdf8;
  animation: pulseBeacon 1.2s infinite;
}

@keyframes pulseBeacon {
  0% { transform: scale(0.8); opacity: 0.5; }
  50% { transform: scale(1.4); opacity: 1; }
  100% { transform: scale(0.8); opacity: 0.5; }
}

.terminal-skip-btn {
  font-size: 22rpx;
  color: #cbd5e1;
  background: #1e293b;
  border: 1rpx solid #334155;
  border-radius: 12rpx;
  padding: 8rpx 18rpx;
  font-weight: 600;
}

.terminal-skip-btn:active {
  background: #334155;
}

/* 阶段推进器 */
.terminal-stages-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 6rpx;
  margin-top: 8rpx;
  border-bottom: 1rpx dashed #1e293b;
}

.stage-tag {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 20rpx;
  color: #64748b;
  transition: all 0.2s ease;
}

.stage-tag.active {
  color: #38bdf8;
  font-weight: 700;
}

.stage-icon {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #1e293b;
  color: #94a3b8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  font-weight: 700;
}

.stage-tag.active .stage-icon {
  background: #38bdf8;
  color: #090d16;
}

.stage-divider {
  flex: 1;
  height: 2rpx;
  background: #1e293b;
  margin: 0 8rpx;
}

.stage-divider.active {
  background: #38bdf8;
}

/* 控制台流式滚动输出区 */
.terminal-scroll-area {
  height: 480rpx;
  margin-top: 16rpx;
}

.terminal-console-body {
  padding: 4rpx;
}

.terminal-text {
  font-size: 23rpx;
  color: #cbd5e1;
  line-height: 1.6;
  white-space: pre-wrap;
  font-family: monospace;
}

.terminal-cursor {
  display: inline-block;
  color: #38bdf8;
  font-weight: 900;
  animation: blink 0.8s infinite;
  margin-left: 4rpx;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

.terminal-footer {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #1e293b;
}

.terminal-hint {
  font-size: 21rpx;
  color: #64748b;
  font-style: italic;
}

/* 核心指标 2x2 宫格 */
.core-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.metric-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  border: 1rpx solid #e2e8f0;
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.03);
}

.metric-label {
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 8rpx;
  display: block;
}

.metric-val-wrap {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.metric-val {
  font-size: 38rpx;
  font-weight: 700;
  color: #0f172a;
}

.metric-unit {
  font-size: 22rpx;
  color: #94a3b8;
}

.status-pass {
  background: #ecfdf5;
  border-color: #a7f3d0;
}

.status-pass .metric-val {
  color: #059669;
}

.status-fail {
  background: #fffbeb;
  border-color: #fde68a;
}

.status-fail .metric-val {
  color: #d97706;
}

/* 响应式表格 */
.table-scroll {
  width: 100%;
  margin-top: 16rpx;
}

.table {
  display: table;
  width: 100%;
  min-width: 600rpx;
  border-collapse: collapse;
}

.table-tr {
  display: table-row;
  border-bottom: 1rpx solid #f1f5f9;
}

.table-th {
  background: #f8fafc;
  font-weight: 600;
  color: #475569;
}

.table-td {
  display: table-cell;
  padding: 16rpx 12rpx;
  font-size: 26rpx;
  vertical-align: middle;
}

.cell-name { width: 35%; }
.cell-amt { width: 25%; }
.cell-price { width: 20%; }
.cell-cost { width: 20%; }

.cell-n-label { width: 30%; }
.cell-n-target { width: 28%; font-size: 24rpx; }
.cell-n-actual { width: 24%; font-size: 24rpx; }
.cell-n-pass { width: 18%; text-align: center; }

.font-bold {
  font-weight: 700;
  color: #0f172a;
}

.table-tfoot {
  background: #f8fafc;
  border-top: 2rpx solid #e2e8f0;
}

.row-fail {
  background: #fffbeb;
}

/* AI 解读盒与头部按钮 */
.ai-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  width: 100%;
}

.ai-card-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 1;
}

.ai-sparkle-icon {
  font-size: 32rpx;
  line-height: 1;
}

.ai-title-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
  white-space: nowrap;
  line-height: 1.2;
}

.btn-refresh-ai {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  font-size: 22rpx;
  font-weight: 600;
  color: #4f46e5;
  background: #eef2ff;
  border: 1rpx solid #c7d2fe;
  border-radius: 24rpx;
  height: 52rpx;
  line-height: 1 !important;
  padding: 0 20rpx !important;
  margin: 0 !important;
  flex-shrink: 0;
}

.btn-refresh-ai::after {
  border: none;
}

.ai-loading-box {
  background: #f5f3ff;
  border: 1rpx dashed #c7d2fe;
  border-radius: 20rpx;
  padding: 36rpx 20rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.ai-box {
  background: linear-gradient(135deg, #f5f3ff 0%, #ede9fe 100%);
  border: 1rpx solid #ddd6fe;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(79, 70, 229, 0.06);
}

.ai-box-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  font-weight: 700;
  color: #4338ca;
  margin-bottom: 12rpx;
}

.ai-text {
  font-size: 26rpx;
  color: #3730a3;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

/* 解读分块 */
.insight-block {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.insight-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
  display: block;
  margin-bottom: 10rpx;
}

.insight-content {
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.6;
}

/* 顺序 4：折叠卡片（其他：贴边与未达标指标） */
.collapse-card {
  padding: 28rpx 32rpx;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
}

.collapse-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}

.collapse-title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.collapse-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #334155;
  line-height: 1;
  display: flex;
  align-items: center;
}

.collapse-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  background: #fef3c7;
  color: #b45309;
  border: 1rpx solid #fde68a;
  padding: 6rpx 14rpx;
  border-radius: 10rpx;
  line-height: 1;
  vertical-align: middle;
}

.collapse-arrow {
  display: inline-flex;
  align-items: center;
  font-size: 26rpx;
  color: #4f46e5;
  font-weight: 600;
  line-height: 1;
}

.collapse-body {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f1f5f9;
}

.sub-section-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1e293b;
  display: block;
  margin-bottom: 10rpx;
}

.violations-list {
  background: #fef2f2;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
}

.violation-item {
  font-size: 25rpx;
  color: #991b1b;
  margin-bottom: 8rpx;
}

.boundary-flags-list {
  background: #fffbeb;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
}

.flag-item {
  font-size: 24rpx;
  color: #92400e;
  margin-bottom: 8rpx;
  line-height: 1.4;
}

.flag-label {
  font-weight: 600;
}

/* 底部协议入口 */
.footer-agreement {
  text-align: center;
  padding: 30rpx 20rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.agreement-text {
  font-size: 22rpx;
  color: #94a3b8;
}

.agreement-link {
  font-size: 24rpx;
  color: #4f46e5;
  text-decoration: underline;
}

/* 免责声明弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.modal-content {
  background: #ffffff;
  width: 100%;
  max-height: 75vh;
  border-top-left-radius: 28rpx;
  border-top-right-radius: 28rpx;
  padding: 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  border-bottom: 1rpx solid #e2e8f0;
  padding-bottom: 16rpx;
}

.modal-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.modal-close {
  font-size: 32rpx;
  color: #94a3b8;
  padding: 0 10rpx;
}

.modal-body {
  flex: 1;
  max-height: 50vh;
  padding-right: 8rpx;
}

.disclaimer-section {
  margin-bottom: 24rpx;
}

.disclaimer-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #334155;
  display: block;
  margin-bottom: 8rpx;
}

.disclaimer-p {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.6;
  display: block;
}

.modal-footer {
  margin-top: 24rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #e2e8f0;
}

/* 称量仪器快捷直连按钮 */
.btn-weigh-link {
  width: 100%;
  height: 84rpx;
  background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
  color: #34d399;
  font-size: 28rpx;
  font-weight: 700;
  border: 1rpx solid #334155;
  border-radius: 18rpx;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  line-height: 1 !important;
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.15);
}

.btn-weigh-link::after {
  border: none;
}

/* ========================================================
   顶层 · DeepSeek 深度推理思考链路 (Thinking Process)
======================================================== */
.thinking-card {
  background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
  border: 1.5rpx solid #38bdf8;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(56, 189, 248, 0.12);
  margin-bottom: 24rpx;
}

.thinking-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.thinking-title-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.thinking-badge-icon {
  font-size: 40rpx;
}

.thinking-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #f8fafc;
}

.tag-reasoning {
  font-size: 18rpx;
  font-weight: 700;
  color: #38bdf8;
  background: rgba(56, 189, 248, 0.18);
  border: 1rpx solid rgba(56, 189, 248, 0.4);
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  text-transform: uppercase;
}

.thinking-subtitle {
  font-size: 21rpx;
  color: #94a3b8;
  display: block;
  margin-top: 4rpx;
}

.thinking-toggle-btn {
  font-size: 22rpx;
  color: #38bdf8;
  font-weight: 600;
  padding: 6rpx 14rpx;
  background: rgba(56, 189, 248, 0.1);
  border-radius: 10rpx;
}

.thinking-body {
  margin-top: 24rpx;
  border-top: 1rpx dashed #334155;
  padding-top: 20rpx;
}

.thinking-steps-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.thinking-step-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.step-num-badge {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #38bdf8;
  color: #0f172a;
  font-size: 20rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.step-content-wrap {
  flex: 1;
}

.step-item-title {
  font-size: 25rpx;
  font-weight: 700;
  color: #e2e8f0;
  display: block;
  margin-bottom: 6rpx;
}

.step-item-desc {
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1.5;
  display: block;
}

.raw-thinking-box {
  background: #090d16;
  border: 1rpx solid #1e293b;
  border-radius: 14rpx;
  padding: 16rpx;
  margin-top: 20rpx;
}

.raw-thinking-title {
  font-size: 20rpx;
  color: #38bdf8;
  font-weight: 600;
  display: block;
  margin-bottom: 6rpx;
}

.raw-thinking-content {
  font-size: 21rpx;
  color: #cbd5e1;
  line-height: 1.5;
  white-space: pre-wrap;
  display: block;
}

/* 加载中的思考预览 */
.loading-thinking-preview {
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  text-align: left;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
}

.thinking-step-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.thinking-pulse-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #10b981;
  animation: pulse 1.2s infinite;
}

@keyframes pulse {
  0% { transform: scale(0.9); opacity: 0.7; }
  50% { transform: scale(1.3); opacity: 1; }
  100% { transform: scale(0.9); opacity: 0.7; }
}

.thinking-step-text {
  font-size: 23rpx;
  color: #475569;
}

/* ========================================================
   全场总用量与多维表格样式
======================================================== */
.card-title-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 14rpx;
}

.card-title-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
  display: block;
}

.card-title-sub {
  font-size: 22rpx;
  color: #64748b;
  display: block;
  margin-top: 4rpx;
}

.flock-summary-banner {
  background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 100%);
  border: 1.5rpx solid #a7f3d0;
  border-radius: 18rpx;
  padding: 20rpx 22rpx;
  margin-top: 8rpx;
  margin-bottom: 12rpx;
}

.flock-summary-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #065f46;
  margin-bottom: 8rpx;
}

.flock-summary-numbers {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.flock-num-val {
  font-size: 36rpx;
  font-weight: 800;
  color: #059669;
}

.flock-num-unit {
  font-size: 22rpx;
  color: #047857;
  margin-left: 8rpx;
}

.cell-flock {
  flex: 1.3 !important;
  text-align: right;
}
