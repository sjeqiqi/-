/* pages/result/result.wxss */

/* 加载动画 */
.spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #e2e8f0;
  border-top-color: #16a34a;
  border-radius: 50%;
  margin: 0 auto;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 核心指标 2x2 宫格 */
.core-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.metric-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #e2e8f0;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.03);
}

.metric-label {
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 8rpx;
  display: block;
}

.metric-val-wrap {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.metric-val {
  font-size: 38rpx;
  font-weight: 700;
  color: #0f172a;
}

.metric-unit {
  font-size: 22rpx;
  color: #94a3b8;
}

.status-pass {
  background: #f0fdf4;
  border-color: #86efac;
}

.status-pass .metric-val {
  color: #16a34a;
}

.status-fail {
  background: #fef2f2;
  border-color: #fca5a5;
}

.status-fail .metric-val {
  color: #dc2626;
}

/* 响应式表格 */
.table-scroll {
  width: 100%;
  margin-top: 16rpx;
}

.table {
  display: table;
  width: 100%;
  min-width: 600rpx;
  border-collapse: collapse;
}

.table-tr {
  display: table-row;
  border-bottom: 1rpx solid #f1f5f9;
}

.table-th {
  background: #f8fafc;
  font-weight: 600;
  color: #475569;
}

.table-td {
  display: table-cell;
  padding: 16rpx 12rpx;
  font-size: 26rpx;
  vertical-align: middle;
}

.cell-name { width: 35%; }
.cell-amt { width: 25%; }
.cell-price { width: 20%; }
.cell-cost { width: 20%; }

.cell-n-label { width: 30%; }
.cell-n-target { width: 28%; font-size: 24rpx; }
.cell-n-actual { width: 24%; font-size: 24rpx; }
.cell-n-pass { width: 18%; text-align: center; }

.font-bold {
  font-weight: 700;
  color: #0f172a;
}

.table-tfoot {
  background: #f8fafc;
  border-top: 2rpx solid #e2e8f0;
}

.row-fail {
  background: #fff5f5;
}

/* 未达标列表 */
.violations-list {
  background: #fef2f2;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}

.violation-item {
  font-size: 26rpx;
  color: #991b1b;
  margin-bottom: 8rpx;
}

/* 贴边提醒 */
.boundary-flags-list {
  background: #fffbeb;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}

.flag-item {
  font-size: 24rpx;
  color: #92400e;
  margin-bottom: 8rpx;
  line-height: 1.4;
}

.flag-label {
  font-weight: 600;
}

/* AI 解读盒 */
.ai-box {
  background: linear-gradient(135deg, #f5f3ff 0%, #ede9fe 100%);
  border: 1rpx solid #ddd6fe;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.ai-box-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  font-weight: 700;
  color: #4338ca;
  margin-bottom: 12rpx;
}

.ai-text {
  font-size: 24rpx;
  color: #3730a3;
  line-height: 1.5;
  margin-bottom: 6rpx;
}

/* 解读分块 */
.insight-block {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.insight-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
  display: block;
  margin-bottom: 10rpx;
}

.insight-content {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.6;
}
