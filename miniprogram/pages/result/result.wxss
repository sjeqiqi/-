/* pages/result/result.wxss */

/* 加载动画 */
.spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #e2e8f0;
  border-top-color: #10b981;
  border-radius: 50%;
  margin: 0 auto;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 核心指标 2x2 宫格 */
.core-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.metric-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  border: 1rpx solid #e2e8f0;
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.03);
}

.metric-label {
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 8rpx;
  display: block;
}

.metric-val-wrap {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.metric-val {
  font-size: 38rpx;
  font-weight: 700;
  color: #0f172a;
}

.metric-unit {
  font-size: 22rpx;
  color: #94a3b8;
}

.status-pass {
  background: #ecfdf5;
  border-color: #a7f3d0;
}

.status-pass .metric-val {
  color: #059669;
}

.status-fail {
  background: #fffbeb;
  border-color: #fde68a;
}

.status-fail .metric-val {
  color: #d97706;
}

/* 响应式表格 */
.table-scroll {
  width: 100%;
  margin-top: 16rpx;
}

.table {
  display: table;
  width: 100%;
  min-width: 600rpx;
  border-collapse: collapse;
}

.table-tr {
  display: table-row;
  border-bottom: 1rpx solid #f1f5f9;
}

.table-th {
  background: #f8fafc;
  font-weight: 600;
  color: #475569;
}

.table-td {
  display: table-cell;
  padding: 16rpx 12rpx;
  font-size: 26rpx;
  vertical-align: middle;
}

.cell-name { width: 35%; }
.cell-amt { width: 25%; }
.cell-price { width: 20%; }
.cell-cost { width: 20%; }

.cell-n-label { width: 30%; }
.cell-n-target { width: 28%; font-size: 24rpx; }
.cell-n-actual { width: 24%; font-size: 24rpx; }
.cell-n-pass { width: 18%; text-align: center; }

.font-bold {
  font-weight: 700;
  color: #0f172a;
}

.table-tfoot {
  background: #f8fafc;
  border-top: 2rpx solid #e2e8f0;
}

.row-fail {
  background: #fffbeb;
}

/* AI 解读盒与刷新按钮 */
.btn-refresh-ai {
  font-size: 22rpx;
  color: #4f46e5;
  background: #eef2ff;
  border: 1rpx solid #c7d2fe;
  border-radius: 20rpx;
  padding: 6rpx 18rpx;
  line-height: 1.4;
  margin: 0;
}

/* 🚀 核心升级：AI 实时流式跳字与推理监控终端 */
.ai-terminal-monitor {
  background: #0f172a;
  border-radius: 20rpx;
  border: 2rpx solid #334155;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.18);
  pointer-events: none; /* 预览框不可点击交互，纯视觉监控 */
}

.terminal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #1e293b;
  padding: 14rpx 24rpx;
  border-bottom: 1rpx solid #334155;
}

.terminal-dots {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.dot-red { background: #ef4444; }
.dot-yellow { background: #f59e0b; }
.dot-green { background: #10b981; }

.terminal-title {
  font-size: 22rpx;
  color: #cbd5e1;
  font-family: monospace;
  margin-left: 8rpx;
  font-weight: 600;
}

.terminal-status {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.radar-spinner {
  width: 22rpx;
  height: 22rpx;
  border: 3rpx solid #475569;
  border-top-color: #38bdf8;
  border-radius: 50%;
  animation: spin 0.6s linear infinite;
}

.status-live-text {
  font-size: 20rpx;
  color: #38bdf8;
  font-weight: 600;
  font-family: monospace;
}

.terminal-screen {
  height: 180rpx;
  max-height: 220rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  background: #090d16;
}

.terminal-logs {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.log-line {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  font-family: monospace;
  font-size: 22rpx;
  line-height: 1.4;
}

.log-prefix {
  color: #6366f1;
  font-weight: 700;
}

.log-text {
  color: #94a3b8;
  word-break: break-all;
}

.log-typing {
  color: #38bdf8;
  font-weight: 600;
  word-break: break-all;
}

.cursor-blink {
  color: #10b981;
  font-size: 20rpx;
  margin-left: 4rpx;
  animation: cursor-blink 0.7s infinite;
}

@keyframes cursor-blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

/* AI 解读最终结果展示 */
.ai-box {
  background: linear-gradient(135deg, #f5f3ff 0%, #ede9fe 100%);
  border: 1rpx solid #ddd6fe;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(79, 70, 229, 0.06);
}

.ai-box-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  font-weight: 700;
  color: #4338ca;
  margin-bottom: 12rpx;
}

.ai-text {
  font-size: 26rpx;
  color: #3730a3;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

/* 解读分块 */
.insight-block {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.insight-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
  display: block;
  margin-bottom: 10rpx;
}

.insight-content {
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.6;
}

/* 顺序 4：折叠卡片（其他：贴边与未达标指标） */
.collapse-card {
  padding: 24rpx 32rpx;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
}

.collapse-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.collapse-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.collapse-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #475569;
}

.collapse-badge {
  font-size: 20rpx;
  background: #fef3c7;
  color: #b45309;
  border: 1rpx solid #fde68a;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

.collapse-arrow {
  font-size: 24rpx;
  color: #4f46e5;
  font-weight: 500;
}

.collapse-body {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f1f5f9;
}

.sub-section-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1e293b;
  display: block;
  margin-bottom: 10rpx;
}

.violations-list {
  background: #fef2f2;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
}

.violation-item {
  font-size: 25rpx;
  color: #991b1b;
  margin-bottom: 8rpx;
}

.boundary-flags-list {
  background: #fffbeb;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
}

.flag-item {
  font-size: 24rpx;
  color: #92400e;
  margin-bottom: 8rpx;
  line-height: 1.4;
}

.flag-label {
  font-weight: 600;
}

/* 底部协议入口 */
.footer-agreement {
  text-align: center;
  padding: 30rpx 20rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.agreement-text {
  font-size: 22rpx;
  color: #94a3b8;
}

.agreement-link {
  font-size: 24rpx;
  color: #4f46e5;
  text-decoration: underline;
}

/* 免责声明弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.modal-content {
  background: #ffffff;
  width: 100%;
  max-height: 75vh;
  border-top-left-radius: 28rpx;
  border-top-right-radius: 28rpx;
  padding: 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  border-bottom: 1rpx solid #e2e8f0;
  padding-bottom: 16rpx;
}

.modal-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.modal-close {
  font-size: 32rpx;
  color: #94a3b8;
  padding: 0 10rpx;
}

.modal-body {
  flex: 1;
  max-height: 50vh;
  padding-right: 8rpx;
}

.disclaimer-section {
  margin-bottom: 24rpx;
}

.disclaimer-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #334155;
  display: block;
  margin-bottom: 8rpx;
}

.disclaimer-p {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.6;
  display: block;
}

.modal-footer {
  margin-top: 24rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #e2e8f0;
}
