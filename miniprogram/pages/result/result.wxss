/* pages/result/result.wxss */

/* 加载动画 */
.spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #e2e8f0;
  border-top-color: #16a34a;
  border-radius: 50%;
  margin: 0 auto;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 核心指标 2x2 宫格 */
.core-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.metric-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #e2e8f0;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.03);
}

.metric-label {
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 8rpx;
  display: block;
}

.metric-val-wrap {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.metric-val {
  font-size: 38rpx;
  font-weight: 700;
  color: #0f172a;
}

.metric-unit {
  font-size: 22rpx;
  color: #94a3b8;
}

.status-pass {
  background: #f0fdf4;
  border-color: #86efac;
}

.status-pass .metric-val {
  color: #16a34a;
}

.status-fail {
  background: #fffbeb;
  border-color: #fde68a;
}

.status-fail .metric-val {
  color: #d97706;
}

/* 响应式表格 */
.table-scroll {
  width: 100%;
  margin-top: 16rpx;
}

.table {
  display: table;
  width: 100%;
  min-width: 600rpx;
  border-collapse: collapse;
}

.table-tr {
  display: table-row;
  border-bottom: 1rpx solid #f1f5f9;
}

.table-th {
  background: #f8fafc;
  font-weight: 600;
  color: #475569;
}

.table-td {
  display: table-cell;
  padding: 16rpx 12rpx;
  font-size: 26rpx;
  vertical-align: middle;
}

.cell-name { width: 35%; }
.cell-amt { width: 25%; }
.cell-price { width: 20%; }
.cell-cost { width: 20%; }

.cell-n-label { width: 30%; }
.cell-n-target { width: 28%; font-size: 24rpx; }
.cell-n-actual { width: 24%; font-size: 24rpx; }
.cell-n-pass { width: 18%; text-align: center; }

.font-bold {
  font-weight: 700;
  color: #0f172a;
}

.table-tfoot {
  background: #f8fafc;
  border-top: 2rpx solid #e2e8f0;
}

.row-fail {
  background: #fffbeb;
}

/* AI 解读盒与刷新按钮 */
.btn-refresh-ai {
  font-size: 22rpx;
  color: #4f46e5;
  background: #eef2ff;
  border: 1rpx solid #c7d2fe;
  border-radius: 20rpx;
  padding: 6rpx 18rpx;
  line-height: 1.4;
  margin: 0;
}

.ai-loading-box {
  background: #f5f3ff;
  border: 1rpx dashed #c7d2fe;
  border-radius: 16rpx;
  padding: 30rpx 20rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.ai-box {
  background: linear-gradient(135deg, #f5f3ff 0%, #ede9fe 100%);
  border: 1rpx solid #ddd6fe;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(79, 70, 229, 0.05);
}

.ai-box-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  font-weight: 700;
  color: #4338ca;
  margin-bottom: 12rpx;
}

.ai-text {
  font-size: 26rpx;
  color: #3730a3;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

/* 解读分块 */
.insight-block {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.insight-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
  display: block;
  margin-bottom: 10rpx;
}

.insight-content {
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.6;
}

/* 底部协议入口 */
.footer-agreement {
  text-align: center;
  padding: 30rpx 20rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.agreement-text {
  font-size: 22rpx;
  color: #94a3b8;
}

.agreement-link {
  font-size: 24rpx;
  color: #4f46e5;
  text-decoration: underline;
}

/* 免责声明弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.modal-content {
  background: #ffffff;
  width: 100%;
  max-height: 75vh;
  border-top-left-radius: 28rpx;
  border-top-right-radius: 28rpx;
  padding: 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  border-bottom: 1rpx solid #e2e8f0;
  padding-bottom: 16rpx;
}

.modal-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.modal-close {
  font-size: 32rpx;
  color: #94a3b8;
  padding: 0 10rpx;
}

.modal-body {
  flex: 1;
  max-height: 50vh;
  padding-right: 8rpx;
}

.disclaimer-section {
  margin-bottom: 24rpx;
}

.disclaimer-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #334155;
  display: block;
  margin-bottom: 8rpx;
}

.disclaimer-p {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.6;
  display: block;
}

.modal-footer {
  margin-top: 24rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #e2e8f0;
}
