<!-- miniprogram/pages/weigh/weigh.wxml -->
<view class="weigh-container">
  
  <!-- 1. 顶部蓝牙连接状态卡片 -->
  <view class="device-card">
    <view class="device-info-left">
      <view class="device-name-row">
        <text class="device-title">{{connected ? 'weigh-machine' : '称量仪器'}}</text>
        <view class="status-pill {{connStateClass}}">
          <view class="pulse-dot"></view>
          <text>{{connStateText}}</text>
        </view>
      </view>
      <text class="device-subtext">
        {{connected ? ('设备ID: ' + deviceId) : '树莓派 BLE 智能称重外设'}}
      </text>
    </view>

    <view class="device-action-right">
      <button 
        wx:if="{{!connected}}" 
        class="btn-connect {{isScanning ? 'scanning' : ''}}" 
        bindtap="handleScanAndConnect" 
        loading="{{isScanning || isConnecting}}"
      >
        {{isScanning ? '正在搜索…' : (isConnecting ? '连接中…' : '搜索连接')}}
      </button>
      <button 
        wx:else 
        class="btn-disconnect" 
        bindtap="handleDisconnect"
      >
        断开连接
      </button>
    </view>
  </view>

  <!-- 搜索中的设备快捷选择面板 (如果搜索到设备或正在搜索) -->
  <view wx:if="{{!connected && (isScanning || discoveredDevices.length > 0)}}" class="card-section scan-devices-box">
    <view class="section-title-row">
      <text class="section-title" style="font-size: 26rpx;">🔍 附近发现的蓝牙设备 ({{discoveredDevices.length}})</text>
      <text wx:if="{{isScanning}}" class="scanning-tip-text">扫描中…</text>
    </view>

    <view wx:if="{{discoveredDevices.length === 0}}" class="scan-loading-tip">
      <view class="status-spinner" style="border-top-color: #38bdf8;"></view>
      <text style="margin-left: 14rpx; font-size: 24rpx; color: #94a3b8;">正在扫描附近的蓝牙广播，请靠近树莓派…</text>
    </view>

    <view class="discovered-list">
      <view 
        wx:for="{{discoveredDevices}}" 
        wx:key="deviceId" 
        class="discovered-item" 
        bindtap="selectConnectDevice" 
        data-device-id="{{item.deviceId}}"
      >
        <view class="discovered-item-left">
          <view class="dev-name-wrap">
            <text class="dev-name">{{item.name || item.localName || '未知名称设备'}}</text>
            <text wx:if="{{item.isTarget}}" class="target-tag">推荐目标</text>
          </view>
          <text class="dev-mac">{{item.deviceId}}</text>
        </view>
        <view class="discovered-item-right">
          <text class="dev-rssi">信号 {{item.RSSI}} dBm</text>
          <button class="btn-item-connect" catchtap="selectConnectDevice" data-device-id="{{item.deviceId}}">
            连接
          </button>
        </view>
      </view>
    </view>

    <!-- 排错提示 -->
    <view class="ble-help-tip" bindtap="openTroubleshootingModal">
      <text>❓ 搜不到设备？点击查看排错指引（安卓定位/系统配对）</text>
    </view>
  </view>

  <!-- 2. 模式切换分段器：配方投喂模式 VS 自由称量模式 -->
  <view wx:if="{{recipeFeedList.length > 0}}" class="mode-segmented-card">
    <view 
      class="mode-seg-item {{activeMode === 'recipe' ? 'active' : ''}}" 
      bindtap="switchMode" 
      data-mode="recipe"
    >
      📋 日粮配方逐项称量 ({{completedCount}}/{{recipeFeedList.length}})
    </view>
    <view 
      class="mode-seg-item {{activeMode === 'custom' ? 'active' : ''}}" 
      bindtap="switchMode" 
      data-mode="custom"
    >
      🎯 自定义/单次称量
    </view>
  </view>

  <!-- 3. 配方投喂任务队列卡片（配方模式） -->
  <view wx:if="{{activeMode === 'recipe' && recipeFeedList.length > 0}}" class="card-section recipe-station-card">
    <view class="section-title-row">
      <view>
        <text class="section-title">🐐 日粮配方投喂流水线</text>
        <text class="section-hint">点击选择原料 ➔ 手动加料进机 ➔ 自动精准称量</text>
      </view>
      <text class="recipe-progress-pill">{{completedCount}} / {{recipeFeedList.length}} 完成</text>
    </view>

    <!-- 原料列表 -->
    <view class="recipe-queue-list">
      <view 
        wx:for="{{recipeFeedList}}" 
        wx:key="feed_id" 
        class="queue-item {{currentFeedIndex === index ? 'item-selected' : ''}} {{item.status === 'done' ? 'item-done' : ''}}"
        bindtap="selectFeedRow"
        data-index="{{index}}"
      >
        <view class="queue-item-left">
          <view class="queue-index-badge {{item.status === 'done' ? 'badge-done' : (currentFeedIndex === index ? 'badge-active' : '')}}">
            {{item.status === 'done' ? '✓' : (index + 1)}}
          </view>
          <view>
            <view class="feed-name-row">
              <text class="feed-item-name">{{item.name}}</text>
              <text wx:if="{{item.status === 'done'}}" class="status-chip done">已完成</text>
              <text wx:elif="{{currentFeedIndex === index}}" class="status-chip active">当前加料</text>
              <text wx:else class="status-chip pending">待投喂</text>
            </view>
            <text class="feed-item-target">目标：{{item.target_g}} g ({{item.as_fed_kg}} kg/天)</text>
          </view>
        </view>

        <view class="queue-item-right">
          <block wx:if="{{item.status === 'done'}}">
            <text class="feed-weighed-val">{{item.weighed_g}} g</text>
            <text class="feed-diff-tag {{item.diff_g >= 0 ? 'plus' : 'minus'}}">
              {{item.diff_g >= 0 ? '+' : ''}}{{item.diff_g}}g
            </text>
          </block>
          <block wx:else>
            <text class="btn-select-hint">{{currentFeedIndex === index ? '正在准备 ➔' : '切换投喂'}}</text>
          </block>
        </view>
      </view>
    </view>

    <!-- 当前选中的投喂操作指引看板 -->
    <view wx:if="{{currentFeedItem}}" class="current-action-banner">
      <view class="action-banner-header">
        <text class="action-banner-step">步骤 {{currentFeedIndex + 1}}</text>
        <text class="action-banner-title">加料指引</text>
      </view>
      <view class="action-banner-content">
        <text class="action-instruction">
          👉 请手动将 <text class="highlight-name">【{{currentFeedItem.name}}】</text> 倒入上方料仓，目标设定为 <text class="highlight-grams">{{currentFeedItem.target_g}} g</text>
        </text>
      </view>

      <!-- 快捷开始当前原料称量 -->
      <button 
        class="btn-start-weigh {{!connected ? 'disabled' : ''}}" 
        bindtap="handleStartCurrentFeedWeighing" 
        disabled="{{!connected || isWeighingRunning}}" 
        loading="{{isWeighingRunning}}"
      >
        {{isWeighingRunning ? '正在自动称量【' + currentFeedItem.name + '】…' : '🚀 启动称量【' + currentFeedItem.name + '】(' + currentFeedItem.target_g + 'g)'}}
      </button>
    </view>

    <!-- 全套配方称量完毕祝贺 -->
    <view wx:if="{{completedCount === recipeFeedList.length && recipeFeedList.length > 0}}" class="all-done-banner">
      <text class="all-done-title">🎉 今日配方全部原料已精准投喂完成！</text>
      <text class="all-done-desc">日粮营养均衡达标，称量数据已核验</text>
      <button class="btn-mini-read" style="margin-top: 14rpx;" bindtap="resetRecipeBatch">
        重新投喂此配方
      </button>
    </view>
  </view>

  <!-- 4. 实时重量仪表盘 -->
  <view class="weight-dashboard-card">
    <view class="dashboard-header">
      <text class="dashboard-title">⚖️ 传感器实时称重数值</text>
      <button class="btn-mini-read" bindtap="handleReadWeight" disabled="{{!connected}}">
        立即测重
      </button>
    </view>

    <view class="weight-meter-wrap">
      <text class="weight-number">{{currentWeight !== null ? currentWeight : '--'}}</text>
      <text class="weight-unit">g</text>
    </view>

    <!-- 运行状态指示条 -->
    <view class="status-indicator-bar {{statusClass}}">
      <view class="status-icon-wrap">
        <view class="status-spinner" wx:if="{{isOperating}}"></view>
        <text class="status-emoji" wx:else>{{statusEmoji}}</text>
      </view>
      <text class="status-message">{{statusText}}</text>
    </view>
  </view>

  <!-- 5. 称量结果大卡片（当收到 done 指令时展示） -->
  <view wx:if="{{lastDoneResult}}" class="done-result-card {{lastDoneResult.result === 'pass' ? 'result-pass' : (lastDoneResult.result === 'empty' ? 'result-empty' : 'result-fail')}}">
    <view class="done-header">
      <text class="done-title">
        {{lastDoneResult.result === 'pass' ? '🎉 称量达标（合格）' : (lastDoneResult.result === 'empty' ? '⚠️ 料仓缺料/已空' : '❌ 称量超差（不合格）')}}
      </text>
      <text class="done-tag">{{lastDoneResult.result.toUpperCase()}}</text>
    </view>
    <view class="done-metrics-grid">
      <view class="done-metric-col">
        <text class="metric-key">目标重量</text>
        <text class="metric-val">{{lastDoneResult.target}} g</text>
      </view>
      <view class="done-metric-col">
        <text class="metric-key">最终实际重量</text>
        <text class="metric-val highlight">{{lastDoneResult.final}} g</text>
      </view>
      <view class="done-metric-col">
        <text class="metric-key">实际误差</text>
        <text class="metric-val">{{lastDoneResult.diff >= 0 ? '+' : ''}}{{lastDoneResult.diff}} g</text>
      </view>
    </view>
  </view>

  <!-- 6. 自定义单次称量控制面板（自由模式） -->
  <view wx:if="{{activeMode === 'custom' || recipeFeedList.length === 0}}" class="card-section">
    <view class="section-title-row">
      <text class="section-title">🎯 自定义称量参数</text>
      <text class="section-hint">自由输入克数与误差阈值</text>
    </view>

    <!-- 目标克数输入 -->
    <view class="form-item">
      <view class="form-label-row">
        <text class="form-label">目标重量 (g)</text>
        <text class="form-val-hint">单位：克 (g)</text>
      </view>
      <input 
        class="weigh-input" 
        type="digit" 
        placeholder="请输入目标克数，例如 15" 
        value="{{targetGrams}}" 
        bindinput="onTargetGramsInput" 
        disabled="{{isWeighingRunning}}"
      />
      <!-- 快捷预设芯片 -->
      <view class="preset-chips-scroll">
        <view 
          wx:for="{{presetTargets}}" 
          wx:key="*this" 
          class="preset-chip {{targetGrams == item ? 'active' : ''}}" 
          bindtap="selectPresetTarget" 
          data-val="{{item}}"
        >
          {{item}}g
        </view>
      </view>
    </view>

    <!-- 允许误差输入 -->
    <view class="form-item">
      <view class="form-label-row">
        <text class="form-label">允许误差 (±g)</text>
        <text class="form-val-hint">默认 ±2g</text>
      </view>
      <input 
        class="weigh-input" 
        type="digit" 
        placeholder="例如 2" 
        value="{{toleranceGrams}}" 
        bindinput="onToleranceInput" 
        disabled="{{isWeighingRunning}}"
      />
      <!-- 快捷误差芯片 -->
      <view class="preset-chips-scroll">
        <view 
          wx:for="{{presetTolerances}}" 
          wx:key="*this" 
          class="preset-chip {{toleranceGrams == item ? 'active' : ''}}" 
          bindtap="selectPresetTolerance" 
          data-val="{{item}}"
        >
          ±{{item}}g
        </view>
      </view>
    </view>

    <!-- 开始称量大按钮 -->
    <button 
      class="btn-start-weigh {{!connected ? 'disabled' : ''}}" 
      bindtap="handleStartWeighing" 
      disabled="{{!connected || isWeighingRunning}}" 
      loading="{{isWeighingRunning}}"
    >
      {{isWeighingRunning ? '自动称量执行中…' : '🚀 开始自动称量 (Weigh)'}}
    </button>
  </view>

  <!-- 7. 执行机构与手动调试面板 -->
  <view class="card-section">
    <view class="section-title-row">
      <text class="section-title">🛠️ 执行机构手动控制</text>
      <text class="section-hint">闸门 / 滑门 / 自检</text>
    </view>

    <!-- 上方滑门 -->
    <view class="actuator-row">
      <view class="actuator-info">
        <text class="actuator-name">上方滑门 (Slide Gate)</text>
        <text class="actuator-desc">控制上方原料进料下落</text>
      </view>
      <view class="actuator-btns">
        <button class="btn-actuator open" bindtap="handleSlideOpen" disabled="{{!connected}}">
          打开滑门
        </button>
        <button class="btn-actuator close" bindtap="handleSlideClose" disabled="{{!connected}}">
          关闭滑门
        </button>
      </view>
    </view>

    <!-- 下方闸门 -->
    <view class="actuator-row">
      <view class="actuator-info">
        <text class="actuator-name">下方闸门 (Discharge Gate)</text>
        <text class="actuator-desc">控制称量斗向料槽放料</text>
      </view>
      <view class="actuator-btns">
        <button class="btn-actuator open" bindtap="handleGateOpen" disabled="{{!connected}}">
          打开闸门
        </button>
        <button class="btn-actuator close" bindtap="handleGateClose" disabled="{{!connected}}">
          关闭闸门
        </button>
      </view>
    </view>

    <!-- 整机自检 -->
    <view class="actuator-row" style="border-bottom: none; padding-bottom: 0;">
      <view class="actuator-info">
        <text class="actuator-name">整机系统自检 (Self-Test)</text>
        <text class="actuator-desc">电机、传感器与通信链路校验</text>
      </view>
      <button class="btn-actuator selftest" bindtap="handleSelfTest" disabled="{{!connected}}">
        ⚡ 机器自检
      </button>
    </view>
  </view>

  <!-- 8. 实时通信数据包日志（可折叠） -->
  <view class="card-section log-section">
    <view class="log-header" bindtap="toggleLogs">
      <view class="log-title-row">
        <text class="section-title" style="font-size: 26rpx; margin-bottom: 0;">📡 BLE 实时通信数据包日志</text>
        <text class="log-count-badge">{{logs.length}}</text>
      </view>
      <view class="log-actions">
        <text class="log-clear-link" catchtap="clearLogs">清空</text>
        <text class="log-arrow">{{showLogs ? '▲' : '▼'}}</text>
      </view>
    </view>

    <scroll-view wx:if="{{showLogs}}" scroll-y class="log-scroll-view" scroll-into-view="{{lastLogId}}">
      <view wx:if="{{logs.length === 0}}" class="log-empty">暂无通信数据包</view>
      <view 
        wx:for="{{logs}}" 
        wx:key="id" 
        id="{{item.id}}" 
        class="log-item {{item.type}}"
      >
        <text class="log-time">{{item.time}}</text>
        <text class="log-tag">[{{item.type.toUpperCase()}}]</text>
        <text class="log-msg">{{item.msg}}</text>
      </view>
    </scroll-view>
  </view>

  <!-- 9. 蓝牙连接排错指南弹窗 -->
  <view wx:if="{{showTroubleModal}}" class="modal-mask" bindtap="closeTroubleModal">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-header">
        <text class="modal-title">💡 蓝牙搜索连接排错指引</text>
        <text class="modal-close" bindtap="closeTroubleModal">✕</text>
      </view>
      <scroll-view scroll-y class="modal-body">
        <view class="trouble-item">
          <text class="trouble-q">1. ⚠️ 千万不要在手机系统蓝牙设置中手动配对</text>
          <text class="trouble-a">
            如果在手机【设置➔蓝牙】中点击配对了树莓派，手机系统会独占连接并停止广播，导致微信小程序无法搜到。请前往手机系统蓝牙设置，点击树莓派设备并选择【忽略此设备/取消配对】，然后在小程序内直接点击【搜索连接】。
          </text>
        </view>

        <view class="trouble-item">
          <text class="trouble-q">2. 📍 安卓手机请务必开启手机「位置信息(GPS)」</text>
          <text class="trouble-a">
            安卓系统底层规定扫描 BLE 蓝牙外设必须打开手机下拉菜单中的【位置信息/GPS 开关】，并且在微信权限管理中允许【位置信息】和【附近设备】权限。
          </text>
        </view>

        <view class="trouble-item">
          <text class="trouble-q">3. 🍓 确认树莓派 BLE GATT 服务正在运行</text>
          <text class="trouble-a">
            确认树莓派 Python 蓝牙脚本已启动并开启广播（Advertising），广播设备名称或本地名称需包含 weigh 或 weigh-machine。
          </text>
        </view>
      </scroll-view>
      <view class="modal-footer">
        <button class="btn-start-weigh" style="height: 80rpx; font-size: 28rpx; margin-top: 0;" bindtap="closeTroubleModal">
          我知道了，重新搜索
        </button>
      </view>
    </view>
  </view>

</view>
