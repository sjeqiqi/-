/* miniprogram/pages/weigh/weigh.wxss */

page {
  background-color: #0b0f19;
  color: #f8fafc;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Segoe UI", Roboto, sans-serif;
  font-size: 28rpx;
  box-sizing: border-box;
}

.weigh-container {
  padding: 24rpx;
  padding-bottom: 60rpx;
}

/* 1. 顶部蓝牙连接卡片 */
.device-card {
  background: #1e293b;
  border: 1rpx solid #334155;
  border-radius: 24rpx;
  padding: 28rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.3);
}

.device-info-left {
  flex: 1;
}

.device-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.device-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

.status-pill.connected {
  background: rgba(16, 185, 129, 0.15);
  color: #34d399;
  border: 1rpx solid rgba(52, 211, 153, 0.4);
}

.status-pill.connecting, .status-pill.scanning {
  background: rgba(56, 189, 248, 0.15);
  color: #38bdf8;
  border: 1rpx solid rgba(56, 189, 248, 0.4);
}

.status-pill.disconnected, .status-pill.idle {
  background: rgba(148, 163, 184, 0.15);
  color: #94a3b8;
  border: 1rpx solid rgba(148, 163, 184, 0.3);
}

.pulse-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: currentColor;
}

.status-pill.connected .pulse-dot {
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0% { transform: scale(0.9); opacity: 0.7; }
  50% { transform: scale(1.3); opacity: 1; }
  100% { transform: scale(0.9); opacity: 0.7; }
}

.device-subtext {
  font-size: 22rpx;
  color: #94a3b8;
  display: block;
}

.btn-connect {
  font-size: 26rpx;
  font-weight: 600;
  color: #ffffff;
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  border-radius: 18rpx;
  padding: 12rpx 28rpx;
  line-height: 1.4;
  margin: 0;
  box-shadow: 0 4rpx 14rpx rgba(16, 185, 129, 0.3);
}

.btn-disconnect {
  font-size: 24rpx;
  color: #f87171;
  background: rgba(239, 68, 68, 0.15);
  border: 1rpx solid rgba(239, 68, 68, 0.3);
  border-radius: 18rpx;
  padding: 10rpx 24rpx;
  line-height: 1.4;
  margin: 0;
}

/* 2. 实时重量仪表盘 */
.weight-dashboard-card {
  background: linear-gradient(145deg, #1e293b 0%, #0f172a 100%);
  border: 1rpx solid #334155;
  border-radius: 28rpx;
  padding: 36rpx 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.4);
  text-align: center;
  position: relative;
  overflow: hidden;
}

.weight-dashboard-card::before {
  content: '';
  position: absolute;
  top: -50rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 280rpx;
  height: 280rpx;
  background: radial-gradient(circle, rgba(16, 185, 129, 0.15) 0%, rgba(16, 185, 129, 0) 70%);
  pointer-events: none;
}

.dashboard-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.dashboard-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #94a3b8;
}

.btn-mini-read {
  font-size: 22rpx;
  color: #38bdf8;
  background: rgba(56, 189, 248, 0.12);
  border: 1rpx solid rgba(56, 189, 248, 0.3);
  border-radius: 20rpx;
  padding: 6rpx 20rpx;
  line-height: 1.4;
  margin: 0;
}

.weight-meter-wrap {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 12rpx;
  margin: 20rpx 0 32rpx;
}

.weight-number {
  font-size: 96rpx;
  font-weight: 800;
  color: #34d399;
  font-family: -apple-system, BlinkMacSystemFont, "DIN Alternate", "Helvetica Neue", Roboto, sans-serif;
  letter-spacing: -2rpx;
  text-shadow: 0 0 30rpx rgba(52, 211, 153, 0.3);
}

.weight-unit {
  font-size: 36rpx;
  font-weight: 700;
  color: #94a3b8;
}

.status-indicator-bar {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(30, 41, 59, 0.8);
  border: 1rpx solid #475569;
  border-radius: 30rpx;
  padding: 10rpx 28rpx;
  max-width: 90%;
}

.status-indicator-bar.operating {
  border-color: #38bdf8;
  background: rgba(56, 189, 248, 0.12);
}

.status-spinner {
  width: 24rpx;
  height: 24rpx;
  border: 4rpx solid rgba(56, 189, 248, 0.3);
  border-top-color: #38bdf8;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.status-emoji {
  font-size: 26rpx;
}

.status-message {
  font-size: 24rpx;
  font-weight: 600;
  color: #e2e8f0;
}

/* 3. 称量结果大卡片 */
.done-result-card {
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.3);
  animation: slideDown 0.3s ease;
}

@keyframes slideDown {
  from { opacity: 0; transform: translateY(-16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.done-result-card.result-pass {
  background: linear-gradient(135deg, rgba(16, 185, 129, 0.2) 0%, rgba(5, 150, 105, 0.1) 100%);
  border: 2rpx solid #10b981;
}

.done-result-card.result-fail {
  background: linear-gradient(135deg, rgba(239, 68, 68, 0.2) 0%, rgba(185, 28, 28, 0.1) 100%);
  border: 2rpx solid #ef4444;
}

.done-result-card.result-empty {
  background: linear-gradient(135deg, rgba(245, 158, 11, 0.2) 0%, rgba(180, 83, 9, 0.1) 100%);
  border: 2rpx solid #f59e0b;
}

.done-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.done-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
}

.done-tag {
  font-size: 22rpx;
  font-weight: 800;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
}

.done-metrics-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 16rpx;
  background: rgba(15, 23, 42, 0.5);
  border-radius: 16rpx;
  padding: 18rpx 12rpx;
}

.done-metric-col {
  text-align: center;
}

.metric-key {
  font-size: 22rpx;
  color: #94a3b8;
  display: block;
  margin-bottom: 6rpx;
}

.metric-val {
  font-size: 28rpx;
  font-weight: 700;
  color: #f8fafc;
}

.metric-val.highlight {
  font-size: 32rpx;
  color: #34d399;
}

/* 4. 区域卡片通用 */
.card-section {
  background: #1e293b;
  border: 1rpx solid #334155;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.2);
}

.section-title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
}

.section-hint {
  font-size: 22rpx;
  color: #64748b;
}

/* 表单组 */
.form-item {
  margin-bottom: 26rpx;
}

.form-label-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.form-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #cbd5e1;
}

.form-val-hint {
  font-size: 22rpx;
  color: #64748b;
}

.weigh-input {
  width: 100%;
  height: 88rpx;
  background: #0f172a;
  border: 2rpx solid #475569;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #34d399;
  box-sizing: border-box;
}

.preset-chips-scroll {
  display: flex;
  gap: 12rpx;
  margin-top: 14rpx;
  flex-wrap: wrap;
}

.preset-chip {
  font-size: 24rpx;
  color: #94a3b8;
  background: #0f172a;
  border: 1rpx solid #334155;
  padding: 8rpx 22rpx;
  border-radius: 20rpx;
  transition: all 0.2s ease;
}

.preset-chip.active {
  color: #34d399;
  background: rgba(16, 185, 129, 0.18);
  border-color: #10b981;
  font-weight: 700;
}

.btn-start-weigh {
  width: 100%;
  height: 94rpx;
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 20rpx;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  line-height: 1 !important;
  margin-top: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(16, 185, 129, 0.35);
}

.btn-start-weigh.disabled {
  opacity: 0.5;
  background: #475569;
  box-shadow: none;
}

/* 5. 执行机构手动控制 */
.actuator-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #334155;
}

.actuator-info {
  flex: 1;
}

.actuator-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #f1f5f9;
  display: block;
  margin-bottom: 4rpx;
}

.actuator-desc {
  font-size: 22rpx;
  color: #64748b;
  display: block;
}

.actuator-btns {
  display: flex;
  gap: 12rpx;
}

.btn-actuator {
  font-size: 24rpx;
  font-weight: 600;
  padding: 12rpx 22rpx;
  border-radius: 16rpx;
  line-height: 1.4;
  margin: 0;
}

.btn-actuator.open {
  background: rgba(16, 185, 129, 0.18);
  color: #34d399;
  border: 1rpx solid rgba(16, 185, 129, 0.4);
}

.btn-actuator.close {
  background: rgba(239, 68, 68, 0.18);
  color: #f87171;
  border: 1rpx solid rgba(239, 68, 68, 0.4);
}

.btn-actuator.selftest {
  background: rgba(56, 189, 248, 0.18);
  color: #38bdf8;
  border: 1rpx solid rgba(56, 189, 248, 0.4);
}

.btn-actuator[disabled] {
  opacity: 0.4;
}

/* 6. 通信日志 */
.log-section {
  padding: 20rpx 24rpx;
}

.log-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.log-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.log-count-badge {
  font-size: 20rpx;
  background: #334155;
  color: #94a3b8;
  padding: 2rpx 10rpx;
  border-radius: 10rpx;
}

.log-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.log-clear-link {
  font-size: 22rpx;
  color: #64748b;
}

.log-arrow {
  font-size: 22rpx;
  color: #94a3b8;
}

.log-scroll-view {
  max-height: 320rpx;
  background: #0b0f19;
  border-radius: 16rpx;
  padding: 16rpx;
  margin-top: 16rpx;
  box-sizing: border-box;
}

.log-empty {
  font-size: 22rpx;
  color: #64748b;
  text-align: center;
  padding: 30rpx 0;
}

.log-item {
  font-size: 22rpx;
  font-family: "Courier New", Courier, monospace;
  margin-bottom: 8rpx;
  word-break: break-all;
  line-height: 1.4;
}

.log-item.tx { color: #38bdf8; }
.log-item.rx { color: #34d399; }
.log-item.info { color: #94a3b8; }
.log-item.error { color: #f87171; }

.log-time {
  color: #64748b;
  margin-right: 8rpx;
}

.log-tag {
  font-weight: 700;
  margin-right: 8rpx;
}

/* 7. 弹窗选择设备 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.modal-content {
  background: #1e293b;
  width: 100%;
  max-height: 65vh;
  border-top-left-radius: 28rpx;
  border-top-right-radius: 28rpx;
  padding: 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  border-bottom: 1rpx solid #334155;
  padding-bottom: 16rpx;
}

.modal-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
}

.modal-close {
  font-size: 32rpx;
  color: #94a3b8;
  padding: 0 10rpx;
}

.modal-device-list {
  flex: 1;
  max-height: 45vh;
}

.device-list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #0f172a;
  border: 1rpx solid #334155;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.device-list-name .name {
  font-size: 28rpx;
  font-weight: 600;
  color: #f1f5f9;
  display: block;
}

.device-list-name .mac {
  font-size: 20rpx;
  color: #64748b;
  display: block;
}

.device-list-rssi {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

.btn-list-connect {
  background: #10b981;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
}

/* 发现设备直接列表 */
.scan-devices-box {
  background: #162032;
  border: 1rpx solid #38bdf8;
  box-shadow: 0 0 20rpx rgba(56, 189, 248, 0.15);
}

.scanning-tip-text {
  font-size: 22rpx;
  color: #38bdf8;
  animation: pulse 1.5s infinite;
}

.scan-loading-tip {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

.discovered-list {
  margin-top: 14rpx;
}

.discovered-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #0f172a;
  border: 1rpx solid #334155;
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 14rpx;
  transition: all 0.2s ease;
}

.discovered-item:active {
  border-color: #10b981;
}

.dev-name-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 4rpx;
}

.dev-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #f1f5f9;
}

.target-tag {
  font-size: 20rpx;
  color: #10b981;
  background: rgba(16, 185, 129, 0.18);
  border: 1rpx solid rgba(16, 185, 129, 0.4);
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

.dev-mac {
  font-size: 20rpx;
  color: #64748b;
  font-family: monospace;
}

.discovered-item-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.dev-rssi {
  font-size: 20rpx;
  color: #94a3b8;
}

.btn-item-connect {
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  padding: 10rpx 24rpx;
  border-radius: 14rpx;
  line-height: 1.4;
  margin: 0;
}

.ble-help-tip {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #334155;
  text-align: center;
  font-size: 22rpx;
  color: #38bdf8;
}

/* 排错弹窗内容 */
.trouble-item {
  margin-bottom: 24rpx;
}

.trouble-q {
  font-size: 26rpx;
  font-weight: 700;
  color: #f8fafc;
  display: block;
  margin-bottom: 8rpx;
}

.trouble-a {
  font-size: 24rpx;
  color: #94a3b8;
  line-height: 1.6;
  display: block;
}

/* ==========================================
   模式分段器与配方流水线卡片
========================================== */
.mode-segmented-card {
  display: flex;
  background: #1e293b;
  border: 1rpx solid #334155;
  border-radius: 20rpx;
  padding: 8rpx;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.mode-seg-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 10rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: #94a3b8;
  border-radius: 14rpx;
  transition: all 0.2s ease;
}

.mode-seg-item.active {
  background: #0f172a;
  color: #34d399;
  border: 1rpx solid rgba(52, 211, 153, 0.4);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
}

.recipe-station-card {
  background: linear-gradient(180deg, #1e293b 0%, #162032 100%);
  border: 1rpx solid #38bdf8;
  box-shadow: 0 8rpx 28rpx rgba(56, 189, 248, 0.12);
}

.recipe-progress-pill {
  font-size: 22rpx;
  font-weight: 700;
  color: #38bdf8;
  background: rgba(56, 189, 248, 0.15);
  border: 1rpx solid rgba(56, 189, 248, 0.3);
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
}

.recipe-queue-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 14rpx;
  margin-bottom: 24rpx;
}

.queue-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #0f172a;
  border: 1rpx solid #334155;
  border-radius: 18rpx;
  padding: 20rpx 22rpx;
  transition: all 0.2s ease;
}

.queue-item.item-selected {
  border-color: #38bdf8;
  background: #152238;
  box-shadow: 0 0 16rpx rgba(56, 189, 248, 0.2);
}

.queue-item.item-done {
  border-color: #059669;
  background: rgba(6, 78, 59, 0.2);
}

.queue-item-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.queue-index-badge {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #334155;
  color: #cbd5e1;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.queue-index-badge.badge-active {
  background: #38bdf8;
  color: #0f172a;
}

.queue-index-badge.badge-done {
  background: #10b981;
  color: #ffffff;
}

.feed-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 4rpx;
}

.feed-item-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff;
}

.status-chip {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.status-chip.pending {
  background: #334155;
  color: #94a3b8;
}

.status-chip.active {
  background: rgba(56, 189, 248, 0.2);
  color: #38bdf8;
  border: 1rpx solid rgba(56, 189, 248, 0.4);
}

.status-chip.done {
  background: rgba(16, 185, 129, 0.2);
  color: #34d399;
  border: 1rpx solid rgba(52, 211, 153, 0.4);
}

.feed-item-target {
  font-size: 22rpx;
  color: #94a3b8;
}

.queue-item-right {
  text-align: right;
}

.feed-weighed-val {
  font-size: 28rpx;
  font-weight: 700;
  color: #34d399;
  display: block;
}

.feed-diff-tag {
  font-size: 20rpx;
  font-weight: 600;
}

.feed-diff-tag.plus { color: #38bdf8; }
.feed-diff-tag.minus { color: #f59e0b; }

.btn-select-hint {
  font-size: 22rpx;
  color: #38bdf8;
}

/* 当前加料指引看板 */
.current-action-banner {
  background: #0f172a;
  border: 1rpx solid #38bdf8;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-top: 10rpx;
}

.action-banner-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.action-banner-step {
  font-size: 20rpx;
  background: #38bdf8;
  color: #0f172a;
  font-weight: 800;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

.action-banner-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #94a3b8;
}

.action-instruction {
  font-size: 27rpx;
  color: #f1f5f9;
  line-height: 1.6;
}

.highlight-name {
  color: #38bdf8;
  font-weight: 700;
  font-size: 30rpx;
}

.highlight-grams {
  color: #34d399;
  font-weight: 700;
  font-size: 30rpx;
}

/* 全套完成横幅 */
.all-done-banner {
  background: linear-gradient(135deg, rgba(16, 185, 129, 0.2) 0%, rgba(5, 150, 105, 0.1) 100%);
  border: 1rpx solid #10b981;
  border-radius: 20rpx;
  padding: 24rpx;
  text-align: center;
  margin-top: 14rpx;
}

.all-done-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #34d399;
  display: block;
  margin-bottom: 6rpx;
}

.all-done-desc {
  font-size: 22rpx;
  color: #cbd5e1;
  display: block;
}
