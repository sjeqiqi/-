/** miniprogram/app.wxss **/

page {
  background-color: #f8fafc;
  color: #1e293b;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

/* 容器通用布局 */
.container {
  padding: 24rpx;
  max-width: 750rpx;
  margin: 0 auto;
}

/* 顶部步骤条导航 */
.steps-bar {
  display: flex;
  background: #ffffff;
  padding: 24rpx 16rpx;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
  border: 1rpx solid #e2e8f0;
}

.step-item {
  flex: 1;
  text-align: center;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.step-item:not(:last-child)::after {
  content: '';
  position: absolute;
  top: 30rpx;
  right: -50%;
  width: 100%;
  height: 4rpx;
  background: #e2e8f0;
  z-index: 1;
}

.step-item.active:not(:last-child)::after,
.step-item.completed:not(:last-child)::after {
  background: #16a34a;
}

.step-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f1f5f9;
  color: #64748b;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  position: relative;
  z-index: 2;
  margin-bottom: 10rpx;
}

.step-item.active .step-icon {
  background: #16a34a;
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(22, 163, 74, 0.3);
}

.step-item.completed .step-icon {
  background: #dcfce7;
  color: #166534;
}

.step-text {
  font-size: 24rpx;
  color: #64748b;
  font-weight: 500;
}

.step-item.active .step-text {
  color: #16a34a;
  font-weight: 600;
}

/* 卡片基础样式 */
.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #e2e8f0;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.04);
}

.card-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 8rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-subtitle {
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 24rpx;
}

/* 表单组 */
.form-group {
  margin-bottom: 28rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #334155;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 84rpx;
  border: 2rpx solid #cbd5e1;
  border-radius: 14rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #0f172a;
  background: #ffffff;
  box-sizing: border-box;
}

.form-input:focus {
  border-color: #16a34a;
}

.form-hint {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 8rpx;
  display: block;
}

.form-select {
  width: 100%;
  height: 84rpx;
  border: 2rpx solid #cbd5e1;
  border-radius: 14rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #0f172a;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

/* 按钮规范 */
.btn-row {
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
  margin-bottom: 40rpx;
}

.btn-primary {
  flex: 1;
  background: linear-gradient(135deg, #16a34a 0%, #15803d 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 16rpx;
  text-align: center;
  border: none;
  box-shadow: 0 6rpx 16rpx rgba(22, 163, 74, 0.25);
}

.btn-primary:active {
  opacity: 0.9;
  transform: scale(0.99);
}

.btn-secondary {
  flex: 1;
  background: #f1f5f9;
  color: #475569;
  font-size: 30rpx;
  font-weight: 600;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 16rpx;
  text-align: center;
  border: 1rpx solid #cbd5e1;
}

.btn-secondary:active {
  background: #e2e8f0;
}

.btn-ai {
  background: linear-gradient(135deg, #4f46e5 0%, #3730a3 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 16rpx 28rpx;
  border-radius: 12rpx;
  border: none;
}

/* 提示与状态标签 */
.badge-green {
  background: #dcfce7;
  color: #15803d;
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.badge-yellow {
  background: #fef3c7;
  color: #b45309;
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.badge-red {
  background: #fee2e2;
  color: #b91c1c;
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.alert-box {
  padding: 20rpx 24rpx;
  border-radius: 14rpx;
  margin-bottom: 24rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

.alert-box.alert-warning {
  background: #fffbeb;
  border: 1rpx solid #fde68a;
  color: #92400e;
}

.alert-box.alert-danger {
  background: #fef2f2;
  border: 1rpx solid #fecaca;
  color: #991b1b;
}

.alert-box.alert-success {
  background: #f0fdf4;
  border: 1rpx solid #bbf7d0;
  color: #166534;
}
