/** miniprogram/app.wxss **/

page {
  background-color: #f1f5f9;
  color: #1e293b;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Segoe UI", Roboto, sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

/* 容器通用布局 */
.container {
  padding: 24rpx;
  max-width: 750rpx;
  margin: 0 auto;
}

/* 顶部步骤条导航 */
.steps-bar {
  display: flex;
  background: #ffffff;
  padding: 24rpx 16rpx;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.04);
  border: 1rpx solid #e2e8f0;
}

.step-item {
  flex: 1;
  text-align: center;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.step-item:not(:last-child)::after {
  content: '';
  position: absolute;
  top: 30rpx;
  right: -50%;
  width: 100%;
  height: 4rpx;
  background: #e2e8f0;
  z-index: 1;
}

.step-item.active:not(:last-child)::after,
.step-item.completed:not(:last-child)::after {
  background: #10b981;
}

.step-icon {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: #f1f5f9;
  color: #64748b;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  position: relative;
  z-index: 2;
  margin-bottom: 10rpx;
  transition: all 0.3s ease;
}

.step-item.active .step-icon {
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  color: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(16, 185, 129, 0.35);
  transform: scale(1.05);
}

.step-item.completed .step-icon {
  background: #ecfdf5;
  color: #059669;
  border: 1rpx solid #a7f3d0;
}

.step-text {
  font-size: 24rpx;
  color: #64748b;
  font-weight: 500;
}

.step-item.active .step-text {
  color: #059669;
  font-weight: 700;
}

/* 卡片基础样式 */
.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #e2e8f0;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.04);
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 8rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-subtitle {
  font-size: 25rpx;
  color: #64748b;
  margin-bottom: 24rpx;
  line-height: 1.4;
}

/* 表单组 */
.form-group {
  margin-bottom: 28rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #334155;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid #cbd5e1;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #0f172a;
  background: #ffffff;
  box-sizing: border-box;
  transition: border-color 0.2s ease;
}

.form-input:focus {
  border-color: #10b981;
}

.form-hint {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 8rpx;
  display: block;
}

.form-select {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid #cbd5e1;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #0f172a;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

/* 按钮规范 */
.btn-row {
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
  margin-bottom: 40rpx;
}

.btn-primary {
  flex: 1;
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  height: 94rpx;
  line-height: 94rpx;
  border-radius: 20rpx;
  text-align: center;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(5, 150, 105, 0.28);
  transition: all 0.2s ease;
}

.btn-primary:active {
  opacity: 0.92;
  transform: scale(0.98);
}

.btn-secondary {
  flex: 1;
  background: #f8fafc;
  color: #475569;
  font-size: 30rpx;
  font-weight: 600;
  height: 94rpx;
  line-height: 94rpx;
  border-radius: 20rpx;
  text-align: center;
  border: 2rpx solid #cbd5e1;
}

.btn-secondary:active {
  background: #f1f5f9;
}

/* 提示与状态标签 */
.badge-green {
  background: #ecfdf5;
  color: #059669;
  border: 1rpx solid #a7f3d0;
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 10rpx;
  font-weight: 600;
}

.badge-yellow {
  background: #fef3c7;
  color: #b45309;
  border: 1rpx solid #fde68a;
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 10rpx;
  font-weight: 600;
}

.badge-red {
  background: #fee2e2;
  color: #b91c1c;
  border: 1rpx solid #fecaca;
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 10rpx;
  font-weight: 600;
}

.alert-box {
  padding: 22rpx 26rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

.alert-box.alert-warning {
  background: #fffbeb;
  border: 1rpx solid #fde68a;
  color: #92400e;
}

.alert-box.alert-danger {
  background: #fef2f2;
  border: 1rpx solid #fecaca;
  color: #991b1b;
}

.alert-box.alert-success {
  background: #ecfdf5;
  border: 1rpx solid #a7f3d0;
  color: #059669;
}
